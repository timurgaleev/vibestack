#!/usr/bin/env bash
# vibestack uninstall — remove skills from selected targets, vibe-* binaries,
# and (optionally) state.
# v1.4.0: multi-target uninstall mirrors install --target= semantics.
set -uo pipefail

REPO_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILLS_SRC="$REPO_DIR/skills"
VIBE_HOME="${VIBESTACK_HOME:-$HOME/.vibestack}"
VIBE_BIN="$VIBE_HOME/bin"

usage() {
  cat <<'EOF'
Usage: ./uninstall [options]

Options:
  --target=<list>     Comma-separated targets: claude, cursor, kiro, codex, or all.
  --scope=<s>         user (default) or project — must match how you installed.
  --project-root=<d>  Project root for --scope=project (default: $PWD).
                      Default: claude (preserves v1.3.x behavior).
  --delete-state      Bypass the prompt and delete ~/.vibestack/ (learnings,
                      analytics, project state).
  --with-config       Also remove the configuration this pack deployed into
                      ~/.claude, ~/.cursor, ~/.kiro and ~/.codex. Only files
                      the install manifest recorded are removed, plus the
                      marked region of the two files we co-own, plus the keys
                      the install merged into settings.json, cli-config.json,
                      hooks.json and agents/default.json — each restored to the
                      value it had before, or dropped if it had none. A value
                      you changed since installing is kept and reported.
                      Codex's config.toml is the exception: its merge is
                      line-based and records nothing to undo.
  -h, --help          Show this help and exit.

Examples:
  ./uninstall                          # Claude Code only
  ./uninstall --target=all             # Claude + Cursor + Kiro + Codex
  ./uninstall --target=cursor          # Cursor only
  ./uninstall --target=all --delete-state  # full removal, non-interactive
EOF
}

# Parse args
TARGETS_RAW=""
DELETE_STATE_FLAG=0
WITH_CONFIG=0
SCOPE="user"
PROJECT_ROOT=""

for arg in "$@"; do
  case "$arg" in
    --target=*)
      TARGETS_RAW="${arg#*=}"
      ;;
    --scope=*)
      SCOPE="${arg#*=}"
      ;;
    --project-root=*)
      PROJECT_ROOT="${arg#*=}"
      ;;
    --delete-state)
      DELETE_STATE_FLAG=1
      ;;
    --with-config)
      WITH_CONFIG=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "ERROR: unknown argument: $arg" >&2
      usage >&2
      exit 2
      ;;
  esac
done

# Resolve target list
declare -a TARGETS
if [ -z "$TARGETS_RAW" ]; then
  TARGETS=("claude")
else
  if [ "$TARGETS_RAW" = "all" ]; then
    TARGETS=("claude" "cursor" "kiro" "codex")
  else
    IFS=',' read -ra TARGETS <<< "$TARGETS_RAW"
  fi
  for t in "${TARGETS[@]}"; do
    case "$t" in
      claude|cursor|kiro|codex) ;;
      *)
        echo "ERROR: unknown target '$t'. Valid: claude, cursor, kiro, codex, all." >&2
        exit 2
        ;;
    esac
  done
fi

# Scope resolution (must mirror install's --scope semantics)
case "$SCOPE" in
  user) SCOPE_BASE="$HOME" ;;
  project)
    PROJECT_ROOT="${PROJECT_ROOT:-${VIBESTACK_PROJECT_ROOT:-$PWD}}"
    case "$PROJECT_ROOT" in "~") PROJECT_ROOT="$HOME" ;; "~/"*) PROJECT_ROOT="$HOME/${PROJECT_ROOT#\~/}" ;; esac
    [ -d "$PROJECT_ROOT" ] || { echo "ERROR: project root not found: $PROJECT_ROOT" >&2; exit 2; }
    PROJECT_ROOT="$(cd "$PROJECT_ROOT" && pwd -P)" || { echo "ERROR: cannot resolve project root" >&2; exit 2; }
    SCOPE_BASE="$PROJECT_ROOT"
    echo "Scope: project ($PROJECT_ROOT)"
    ;;
  *) echo "ERROR: invalid --scope '$SCOPE' (user|project)" >&2; exit 2 ;;
esac

# Map target → root (must match install's mapping)
target_root() {
  case "$1" in
    claude) echo "$SCOPE_BASE/.claude/skills" ;;
    cursor) echo "$SCOPE_BASE/.cursor/skills" ;;
    kiro)   echo "$SCOPE_BASE/.kiro/skills" ;;
    # Codex reads skills from .agents/skills, not .codex/skills — ~/.codex holds
    # its config only. Matches install's TARGET_ROOT / TARGET_PROJECT_REL.
    codex)  echo "$SCOPE_BASE/.agents/skills" ;;
    *)      echo "" ;;
  esac
}

# ───────────────────────────────────────────────────────────────────────────
# Per-skill uninstall (v1.4.0 — mirrors install_skill_to_target's split)
# Removes:
#   - <root>/<skill_name>/SKILL.md (regular file written by renderer)
#   - <root>/<skill_name>/.vibe-render.json (sidecar, no-op if absent)
#   - All symlinks in <root>/<skill_name>/ (bin/, sub-docs)
#   - <root>/<skill_name>/ if empty
# Preserves:
#   - Any non-symlink files the user manually placed in <root>/<skill_name>/
#     (per the v1.3.0 contract — see learning vibestack_uninstall_only_removes_symlinks)
# ───────────────────────────────────────────────────────────────────────────
uninstall_skill_from_target() {
  local skill_dir="$1"
  local target_root="$2"
  local skill_name target

  skill_name=$(grep -m1 '^name:' "$skill_dir/SKILL.md" 2>/dev/null \
    | sed 's/^name:[[:space:]]*//' | tr -d '[:space:]')
  [ -z "$skill_name" ] && skill_name="$(basename "$skill_dir")"

  target="$target_root/$skill_name"

  if [ ! -d "$target" ]; then
    return 1  # not found
  fi

  # Remove every symlink we created (sub-docs, bin/). Leave any other
  # non-symlink files alone (they didn't come from us).
  for item in "$target"/* "$target"/.[!.]* "$target"/..?*; do
    [ -e "$item" ] || [ -L "$item" ] || continue
    if [ -L "$item" ]; then
      rm -f "$item"
    fi
  done

  # Remove the rendered SKILL.md (regular file) and its sidecar JSON, if present.
  # Scoped narrowly to the canonical paths we created.
  if [ -f "$target/SKILL.md" ] && [ ! -L "$target/SKILL.md" ]; then
    rm -f "$target/SKILL.md"
  fi
  rm -f "$target/.vibe-render.json"

  # Try to remove the directory. If it's not empty (user added files), leave it.
  if [ -z "$(ls -A "$target" 2>/dev/null)" ]; then
    rmdir "$target" 2>/dev/null
    echo "  - removed $skill_name"
    return 0
  else
    echo "  - kept $skill_name (contains non-vibestack files)"
    return 2  # kept (had user files)
  fi
}

# ───────────────────────────────────────────────────────────────────────────
# Main uninstall flow
# ───────────────────────────────────────────────────────────────────────────

echo "Uninstalling vibestack..."
echo ""

total_removed=0
total_not_found=0
total_not_empty=0

for target in "${TARGETS[@]}"; do
  root=$(target_root "$target")
  if [ -z "$root" ]; then
    echo "ERROR: could not resolve root for target '$target'" >&2
    exit 3
  fi

  if [ ! -d "$root" ]; then
    echo "Target: $target ($root) — not found, skipping"
    continue
  fi

  echo "Target: $target ($root)"

  removed=0
  not_found=0
  not_empty=0

  for skill_dir in "$SKILLS_SRC"/*/; do
    [ -f "$skill_dir/SKILL.md" ] || continue

    set +e
    uninstall_skill_from_target "$skill_dir" "$root"
    rc=$?
    set -e

    case "$rc" in
      0) removed=$((removed + 1)) ;;
      1) not_found=$((not_found + 1)) ;;
      2) removed=$((removed + 1)); not_empty=$((not_empty + 1)) ;;
    esac
  done

  # The install manifest is a regular file at the root of the target, written
  # so the next install can tell a withdrawn skill from someone else's. Nothing
  # reads it once the pack is gone, and leaving it behind would leak across an
  # uninstall the way the sidecars used to.
  rm -f "$root/.vibestack-manifest"

  echo "  $target: $removed processed, $not_found already absent, $not_empty kept (had user files)"
  total_removed=$((total_removed + removed))
  total_not_found=$((total_not_found + not_found))
  total_not_empty=$((total_not_empty + not_empty))
done

echo ""
echo "Skills total: $total_removed processed across ${#TARGETS[@]} target(s), $total_not_found already absent, $total_not_empty kept (had user files)"

# Remove vibe-* binary copies under ~/.vibestack/bin/
echo ""
bin_removed=0
if [ -d "$VIBE_BIN" ]; then
  for bin_file in "$VIBE_BIN"/vibe-* "$VIBE_BIN/vibestack"; do
    [ -f "$bin_file" ] || continue
    rm -f "$bin_file"
    bin_removed=$((bin_removed + 1))
  done
  rm -f "$VIBE_HOME/version"
  echo "Binaries: $bin_removed removed from $VIBE_BIN"
  if [ -z "$(ls -A "$VIBE_BIN" 2>/dev/null)" ]; then
    rmdir "$VIBE_BIN" 2>/dev/null || true
  fi
fi

# ───────────────────────────────────────────────────────────────────────────
# Configuration removal
#
# The install records every file it deployed and owns in a per-target manifest;
# that list is exactly what is safe to delete. Files the user put there are not
# in it. The two marker-delimited files are co-owned: our region is bounded and
# provably ours, so it goes, and everything the user or another tool wrote
# outside it stays.
#
# The fill-missing merges (settings.json, config.toml, hooks.json,
# agents/default.json) are a different matter: the install added keys without
# recording which, so removing "our" keys later would be guesswork against the
# user's own configuration. Those files are reported and left.
# ───────────────────────────────────────────────────────────────────────────
CONFIG_MANIFEST_DIR="${MANIFEST_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/vibekit}"
declare -A CONFIG_DEST=(
  [claude]="$HOME/.claude"
  [cursor]="$HOME/.cursor"
  [kiro]="$HOME/.kiro"
  [codex]="${CODEX_HOME:-$HOME/.codex}"
)
CLAUDE_MD_END="<!-- END vibekit-managed CLAUDE.md — lines below are yours and survive every sync -->"
CODEX_RULES_BEGIN="# BEGIN vibekit managed codex rules"
CODEX_RULES_END="# END vibekit managed codex rules"

config_manifest_path() {
  printf '%s/manifest_%s' "$CONFIG_MANIFEST_DIR" "${1//\//_}"
}

# Drop our region from ~/.claude/CLAUDE.md, keeping every line below the marker.
# No marker means the file is not one we deployed, so it is left as it is.
remove_claude_md_region() {
  local file="$1"
  [ -f "$file" ] || return 0
  if ! grep -qxF "$CLAUDE_MD_END" "$file"; then
    echo "  - kept $file (no managed marker — not ours to edit)"
    return 0
  fi
  local tmp
  tmp="$(mktemp "${file}.vibekit.XXXXXX")" || { echo "  ! could not stage $file"; return 1; }
  awk -v marker="$CLAUDE_MD_END" '
    seen { print; next }
    $0 == marker { seen = 1 }
  ' "$file" > "$tmp" || { rm -f "$tmp"; echo "  ! could not rewrite $file"; return 1; }
  # A file that is only our region leaves nothing behind worth keeping.
  if [ -s "$tmp" ] && grep -q '[^[:space:]]' "$tmp"; then
    mv -f "$tmp" "$file" && echo "  - removed the managed region of $file (kept your lines below it)"
  else
    rm -f "$tmp" "$file" && echo "  - removed $file (nothing of yours was below the marker)"
  fi
}

# The JSON files the install merges into rather than owns outright, per target.
# Mirrors MERGE_MANAGED in lib/config-install.sh plus the two settings files
# that library merges inline. Codex's config.toml is deliberately absent — see
# where it is reported below.
declare -A CONFIG_MERGED_JSON=(
  [claude]="settings.json"
  [cursor]="cli-config.json hooks.json"
  [codex]="hooks.json"
  [kiro]="agents/default.json"
)

snapshot_file() { # snapshot_file <pre|post> <target> <rel>
  printf '%s/%smerge_%s_%s' "$CONFIG_MANIFEST_DIR" "$1" "${2//\//_}" "${3//\//_}"
}

# remove_merged_keys <target> <rel-path>
#
# The install recorded the destination as it stood before it first merged
# (pre) and what it left behind (post). A key whose value still equals the
# post-merge one, and differed before, is ours alone: it is restored to the
# pre-merge value, or dropped if there was none. A key holding anything else
# was changed by the user or the app since, so it stays and is reported.
#
# Nothing here knows how any individual merge works. Comparing the two
# recordings is enough, which is why it covers the fill-missing merges and the
# repo-authoritative ones alike.
remove_merged_keys() {
  local target="$1" rel="$2"
  local dest="${CONFIG_DEST[$target]:-}"
  [ -n "$dest" ] || return 0
  local file="$dest/$rel"
  local pre post
  pre="$(snapshot_file pre "$target" "$rel")"
  post="$(snapshot_file post "$target" "$rel")"

  [ -f "$file" ] || { rm -f "$pre" "$post"; return 0; }
  [ -f "$pre" ] && [ -f "$post" ] || return 0

  if ! command -v python3 >/dev/null 2>&1; then
    echo "  $target: $rel keeps its merged keys — python3 is needed to remove them safely"
    return 0
  fi

  local TMP_REPORT
  TMP_REPORT="$(mktemp)" || { echo "  $target: could not stage a report for $rel — left as it was"; return 0; }

  local out rc=0
  # The redirection belongs to python3, not to the assignment: on an assignment
  # it is set up for the (null) command and the substitution keeps the shell's
  # own stderr, so the report would be printed instead of captured.
  out="$(python3 - "$pre" "$post" "$file" 2>"$TMP_REPORT" <<'PYEOF'
import json, sys

pre_path, post_path, cur_path = sys.argv[1], sys.argv[2], sys.argv[3]
MISSING = object()

def load(path):
    with open(path) as fh:
        return json.load(fh)

try:
    pre, post = load(pre_path), load(post_path)
except (OSError, ValueError) as exc:
    sys.stderr.write("could not read the merge record: %s\n" % exc)
    sys.exit(3)

try:
    cur = load(cur_path)
except (OSError, ValueError) as exc:
    # The destination is not ours to repair. Leaving it byte-identical is the
    # only safe answer.
    sys.stderr.write("unreadable: %s\n" % exc)
    sys.exit(3)

removed, kept = [], []

def label(path, key):
    return ".".join(path + [str(key)])

def walk(cur_node, post_node, pre_node, path):
    """Undo, in cur_node, whatever post_node added on top of pre_node."""
    if not isinstance(cur_node, dict) or not isinstance(post_node, dict):
        return
    pre_node = pre_node if isinstance(pre_node, dict) else {}

    for key, post_val in post_node.items():
        if key not in cur_node:
            continue
        cur_val = cur_node[key]
        pre_val = pre_node.get(key, MISSING)

        # Untouched by the merge: the value was already there and unchanged.
        if pre_val is not MISSING and pre_val == post_val:
            continue

        if isinstance(post_val, list) and isinstance(cur_val, list):
            pre_list = pre_val if isinstance(pre_val, list) else []
            ours = [x for x in post_val if x not in pre_list]
            survivors = [x for x in cur_val if x not in ours]
            dropped = [x for x in cur_val if x in ours]
            if dropped:
                removed.append("%s  (%d entr%s; %d of yours kept)" % (
                    label(path, key), len(dropped),
                    "y" if len(dropped) == 1 else "ies", len(survivors)))
            if survivors or pre_val is not MISSING:
                cur_node[key] = survivors
            else:
                del cur_node[key]
            continue

        if isinstance(post_val, dict) and isinstance(cur_val, dict):
            walk(cur_val, post_val, pre_val if pre_val is not MISSING else {},
                 path + [str(key)])
            # An object that exists only because we created it, now empty.
            if not cur_val and pre_val is MISSING:
                del cur_node[key]
            continue

        if cur_val != post_val:
            kept.append(label(path, key))
            continue

        if pre_val is MISSING:
            del cur_node[key]
            removed.append(label(path, key))
        else:
            cur_node[key] = pre_val
            removed.append("%s  (restored %s)" % (label(path, key),
                                                  json.dumps(pre_val)))

walk(cur, post, pre, [])

for line in removed:
    sys.stderr.write("REMOVED %s\n" % line)
for line in kept:
    sys.stderr.write("KEPT %s\n" % line)
sys.stderr.write("EMPTY\n" if not cur else "")

print(json.dumps(cur, indent=2))
PYEOF
)" || rc=$?

  # 3 is the pass declining on purpose — an unreadable destination or an
  # unreadable record. Anything else is python3 itself failing to run, which a
  # broken interpreter on PATH produces without printing a word. Both keep the
  # file; only the wording differs, and neither may be silent.
  if [ "$rc" -eq 3 ]; then
    echo "  $target: $rel keeps its merged keys — $(head -1 "$TMP_REPORT" 2>/dev/null)"
    rm -f "$TMP_REPORT"
    return 0
  elif [ "$rc" -ne 0 ]; then
    echo "  $target: $rel keeps its merged keys — python3 exited $rc and the keys"
    echo "          cannot be identified without it"
    rm -f "$TMP_REPORT"
    return 0
  fi

  # grep -c prints its count and still exits 1 on no match, so `|| echo 0` would
  # append a second line and every later integer test would fail to parse.
  local n_removed n_kept
  n_removed=$(grep -c '^REMOVED ' "$TMP_REPORT" 2>/dev/null)
  n_kept=$(grep -c '^KEPT ' "$TMP_REPORT" 2>/dev/null)
  n_removed=${n_removed:-0}
  n_kept=${n_kept:-0}

  if grep -qx 'EMPTY' "$TMP_REPORT" 2>/dev/null; then
    rm -f "$file"
    rmdir -p "$(dirname "$file")" 2>/dev/null || true
    echo "  $target: removed $rel (nothing of yours was left in it)"
  elif [ "$n_removed" -gt 0 ]; then
    if printf '%s\n' "$out" > "$file.vibekit.tmp" && mv -f "$file.vibekit.tmp" "$file"; then
      echo "  $target: $n_removed merged key(s) taken back from $rel"
      # The lines worth reading are the ones where something of yours was at
      # stake — a value put back, or an array we only partly own. The rest are
      # keys that were ours outright, and listing twenty of them buries the two
      # that matter, so they are counted instead.
      # -E, not a BRE: BSD sed has no \| alternation, so a basic-regex version
      # matches nothing on macOS and silently prints only the summary line.
      sed -nE 's/^REMOVED (.*(restored|of yours kept).*)/    - \1/p' "$TMP_REPORT"
      local n_plain
      n_plain=$(grep -c '^REMOVED ' "$TMP_REPORT" 2>/dev/null)
      n_plain=$(( ${n_plain:-0} - $(grep -cE '^REMOVED .*(restored|of yours kept)' "$TMP_REPORT" 2>/dev/null || echo 0) ))
      [ "$n_plain" -gt 0 ] && echo "    - and $n_plain key(s) that were ours outright"
    else
      rm -f "$file.vibekit.tmp"
      echo "  $target: could not rewrite $rel — left as it was"
    fi
  else
    echo "  $target: $rel had no merged keys left to take back"
  fi

  if [ "$n_kept" -gt 0 ]; then
    echo "  $target: $n_kept key(s) kept — you changed them since install"
    sed -n 's/^KEPT /    - /p' "$TMP_REPORT"
  fi

  rm -f "$pre" "$post" "$TMP_REPORT"
}

remove_codex_rules_region() {
  local file="$1"
  [ -f "$file" ] || return 0
  if ! grep -qxF "$CODEX_RULES_BEGIN" "$file"; then
    return 0
  fi
  local tmp
  tmp="$(mktemp "${file}.vibekit.XXXXXX")" || { echo "  ! could not stage $file"; return 1; }
  awk -v b="$CODEX_RULES_BEGIN" -v e="$CODEX_RULES_END" '
    $0 == b { skip = 1; next }
    $0 == e { skip = 0; next }
    !skip
  ' "$file" > "$tmp" || { rm -f "$tmp"; echo "  ! could not rewrite $file"; return 1; }
  mv -f "$tmp" "$file" && echo "  - removed the managed rules block from $file"
}

if [ "$WITH_CONFIG" = "1" ]; then
  echo ""
  echo "Configuration:"
  config_removed=0
  config_kept=()
  for target in "${TARGETS[@]}"; do
    dest="${CONFIG_DEST[$target]:-}"
    [ -n "$dest" ] || continue
    manifest="$(config_manifest_path "$target")"
    if [ ! -f "$manifest" ]; then
      echo "  $target: nothing recorded as installed"
      continue
    fi
    removed=0
    while IFS= read -r rel; do
      [ -n "$rel" ] || continue
      file="$dest/$rel"
      if [ -f "$file" ]; then
        rm -f "$file" && removed=$((removed + 1))
        # Take the directory too once we emptied it, never one with anything left.
        rmdir -p "$(dirname "$file")" 2>/dev/null || true
      fi
    done < "$manifest"
    rm -f "$manifest"
    echo "  $target: $removed file(s) removed, manifest cleared"
    config_removed=$((config_removed + removed))
  done

  for target in "${TARGETS[@]}"; do
    case "$target" in
      claude) remove_claude_md_region "$HOME/.claude/CLAUDE.md" ;;
      codex)  remove_codex_rules_region "${CODEX_HOME:-$HOME/.codex}/rules/default.rules" ;;
    esac
  done

  echo ""
  for target in "${TARGETS[@]}"; do
    for rel in ${CONFIG_MERGED_JSON[$target]:-}; do
      remove_merged_keys "$target" "$rel"
    done
  done

  # Codex's config.toml is merged line by line, not as a document, so the same
  # pre/post comparison does not apply to it. Say so rather than let a silence
  # imply it was handled.
  for target in "${TARGETS[@]}"; do
    if [ "$target" = "codex" ] && [ -f "${CODEX_HOME:-$HOME/.codex}/config.toml" ]; then
      echo "  codex: ~/.codex/config.toml keeps its merged keys — the TOML merge"
      echo "         is line-based and records nothing to undo. Edit it by hand."
    fi
  done
elif [ -d "$CONFIG_MANIFEST_DIR" ] && [ -n "$(ls -A "$CONFIG_MANIFEST_DIR" 2>/dev/null)" ]; then
  echo ""
  echo "Configuration files from this pack are still installed."
  echo "  Remove them with: ./uninstall --with-config"
fi

# Decide whether to remove ~/.vibestack/ state.
echo ""
if [ -d "$VIBE_HOME" ] && [ -n "$(ls -A "$VIBE_HOME" 2>/dev/null)" ]; then
  echo "State directory: $VIBE_HOME"
  echo "  Contents:"
  for item in "$VIBE_HOME"/*; do
    [ -e "$item" ] || continue
    echo "    $(basename "$item")"
  done
  echo ""

  reply="n"
  if [ "$DELETE_STATE_FLAG" = "1" ]; then
    reply="y"
    echo "(--delete-state flag set; deleting without prompting)"
  elif [ -r /dev/tty ] && [ -t 0 ]; then
    printf "Delete state directory including learnings and analytics? [y/N] "
    read -r reply </dev/tty || reply="n"
  else
    echo "(non-interactive run — keeping state. Pass --delete-state to force removal.)"
  fi

  case "$reply" in
    y|Y|yes|YES)
      rm -rf "$VIBE_HOME"
      echo "  - deleted $VIBE_HOME"
      ;;
    *)
      echo "  - kept $VIBE_HOME"
      ;;
  esac
fi

# Tell the user what remains
echo ""
echo "What stays (delete manually if you want a full removal):"
echo "  $REPO_DIR    (the cloned repo)"
[ -d "$VIBE_HOME" ] && echo "  $VIBE_HOME    (kept above)"
echo ""
echo "Start a new session of your chosen agent for changes to take effect."
