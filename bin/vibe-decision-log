#!/usr/bin/env python3
"""vibe-decision-log — append a durable decision (or supersede/redact it).

Usage:
  vibe-decision-log '{"decision":"...","rationale":"...","scope":"repo","source":"user"}'
  vibe-decision-log --supersede <decision-id>
  vibe-decision-log --redact <decision-id>

Event-sourced: every call appends one line to
``$VIBESTACK_HOME/projects/<slug>/decisions.jsonl``. The active set is derived at
read time by vibe-decision-search (supersede/redact fold over the log). Local and
reliable — memrain is the semantic-recall layer, not the decision store, mirroring
reference's "log is local; brain not required."

NON-INTERACTIVE — never prompts (skills call this; a prompt would hang them).
A decision carrying a high-confidence secret is rejected (exit 1), nothing written.
"""
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timezone

HOME = os.environ.get("VIBESTACK_HOME", os.path.expanduser("~/.vibestack"))

# A decision body is user/agent text that can travel, so a secret is refused
# before it is persisted.
# --- secret patterns: begin (same labels and placeholder rules as bin/vibe-redact-prepush;
# lib/snippets/secret-scan-patterns.md is the canonical list, test-redact-scan.sh keeps them equal)
SECRET_PATTERNS = [
    ("AWS access key", r"AKIA[0-9A-Z]{16}"),
    ("AWS temporary key", r"ASIA[0-9A-Z]{16}"),
    ("GitHub token", r"gh(p|o|s|u|r)_[A-Za-z0-9]{36}"),
    ("GitHub fine-grained token", r"github_pat_[A-Za-z0-9_]{22,}"),
    ("Slack token", r"xox[abpr]-[A-Za-z0-9-]{10,}"),
    ("Stripe live key", r"(sk|rk)_live_[A-Za-z0-9]{20,}"),
    ("Google API key", r"AIza[0-9A-Za-z_-]{35}"),
    ("Anthropic key", r"sk-ant-[A-Za-z0-9_-]{20,}"),
    ("OpenAI key (modern)", r"sk-(proj|svcacct|admin)-[A-Za-z0-9_-]{20,}"),
    ("OpenAI key (classic)", r"sk-[A-Za-z0-9]{48}"),
    ("GitLab token", r"gl(pat|ptt|dt)-[A-Za-z0-9_-]{20,}"),
    ("HuggingFace token", r"hf_[A-Za-z0-9]{30,}"),
    ("npm token", r"npm_[A-Za-z0-9]{36}"),
    ("DigitalOcean token", r"dop_v1_[a-f0-9]{64}"),
    ("Private key block", r"-----BEGIN[^-\n]*PRIVATE KEY-----"),
    ("AWS secret key", r"aws_secret_access_key[^A-Za-z0-9\n]+[A-Za-z0-9/+=]{40}"),
    ("SecretAccessKey field", r"\"?SecretAccessKey\"?[ \t]*[:=][ \t]*\"?[A-Za-z0-9/+=]{40}"),
    ("env-style secret", r"^[ \t+-]{0,2}[ \t]*(export[ \t]+)?[A-Z][A-Z0-9_]*_(KEY|TOKEN|SECRET|PASSWORD)=..+"),
    ("DSN credentials", r"://[^\s:/@]{1,255}:[^\s@/]{1,255}@"),
]
_SECRET_RES = [(label, re.compile(pat, re.M)) for label, pat in SECRET_PATTERNS]
_BEARER = re.compile(r"Bearer[ \t]+([A-Za-z0-9._~+/=-]{20,})")


def _secret_placeholder(label, span):
    v = span
    if label == "env-style secret":
        v = span.split("=", 1)[1]
    elif label == "SecretAccessKey field":
        v = re.split(r"[:=]", span, maxsplit=1)[1].lstrip()
    elif label == "DSN credentials":
        v = span[3:].split(":", 1)[1][:-1]
    for q in ('"', "'"):
        v = v[1:] if v.startswith(q) else v
        v = v[:-1] if v.endswith(q) else v
    if re.match(r"(your[_-]|<[^>]*>$|[*]+$|x{6,}$|changeme$|redacted|placeholder|dummy|fake)", v, re.I):
        return True
    if re.fullmatch(r"\$\{?[A-Za-z_][A-Za-z0-9_]*\}?", v):
        return True
    if re.match(r"[$][({]", v) or v.endswith("..."):
        return True
    if label == "DSN credentials" and ("$" in v or "{" in v or len(v) < 8 or re.fullmatch(
            r"pass|password|postgres|root|test|secret|admin|change-?me|p", v, re.I)
            or v == span[3:].split(":", 1)[0]):
        return True
    if "://" in v or "@" in v:
        return False
    return re.search(r"^example|example(key)?$", v, re.I) is not None


def find_secret(text):
    """Label of the first high-confidence secret in text, or None."""
    for label, rx in _SECRET_RES:
        for m in rx.finditer(text):
            if not _secret_placeholder(label, m.group(0)):
                return label
    for m in _BEARER.finditer(text):
        tok = m.group(1)
        if (re.search(r"[0-9]", tok) and re.search(r"[a-z]", tok) and re.search(r"[A-Z]", tok)
                and not _secret_placeholder("Bearer token", tok)):
            return "Bearer token"
    return None


def secret_in_payload(raw, obj):
    """Scan the raw JSON and every decoded key and string, one per line, so an
    env-style line or a quoted field inside a value is seen as written."""
    parts = [raw]

    def walk(x):
        if isinstance(x, str):
            parts.append(x)
        elif isinstance(x, dict):
            for k, v in x.items():
                parts.append(str(k))
                walk(v)
        elif isinstance(x, list):
            for v in x:
                walk(v)

    walk(obj)
    return find_secret("\n".join(parts))
# --- secret patterns: end ---


def slug() -> str:
    here = os.path.dirname(os.path.abspath(__file__))
    try:
        out = subprocess.run([os.path.join(here, "vibe-slug")],
                             capture_output=True, text=True, timeout=5).stdout
        m = re.search(r"SLUG=([^\s]+)", out)
        if m:
            return m.group(1)
    except Exception:
        pass
    return "unknown"


def branch() -> str:
    try:
        return subprocess.run(["git", "branch", "--show-current"],
                              capture_output=True, text=True, timeout=5).stdout.strip() or "unknown"
    except Exception:
        return "unknown"


def append(slug_: str, event: dict) -> str:
    path = os.path.join(HOME, "projects", slug_, "decisions.jsonl")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a", encoding="utf-8") as f:
        f.write(json.dumps(event, ensure_ascii=False) + "\n")
    return path


def main() -> int:
    args = sys.argv[1:]
    if not args:
        print(__doc__.strip().split("\n\n")[1], file=sys.stderr)
        return 1

    now = datetime.now(timezone.utc).isoformat()
    did = f"d{int(time.time())}{os.getpid() % 1000:03d}"
    s = slug()

    if args[0] == "--supersede":
        if len(args) < 2:
            print("error: --supersede needs a decision id", file=sys.stderr)
            return 1
        append(s, {"id": did, "ts": now, "type": "supersede", "target": args[1]})
        print(f"superseded {args[1]}")
        return 0

    if args[0] == "--redact":
        if len(args) < 2:
            print("error: --redact needs a decision id", file=sys.stderr)
            return 1
        append(s, {"id": did, "ts": now, "type": "redact", "target": args[1]})
        print(f"redacted {args[1]}")
        return 0

    try:
        body = json.loads(args[0])
    except Exception as e:
        print(f"error: first argument must be a JSON object ({e})", file=sys.stderr)
        return 1
    if not isinstance(body, dict) or not body.get("decision"):
        print('error: JSON must include a non-empty "decision" field', file=sys.stderr)
        return 1

    found = secret_in_payload(args[0], body)
    if found:
        print(f"error: decision rejected — it contains a high-confidence secret ({found}). "
              "Redact and rotate before logging.", file=sys.stderr)
        return 1

    event = {"id": did, "ts": now, "type": "decide", "branch": branch(),
             "decision": body["decision"], "rationale": body.get("rationale", ""),
             "scope": body.get("scope", "repo"), "source": body.get("source", "agent")}
    append(s, event)
    print(f"logged {did}: {body['decision'][:80]}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
