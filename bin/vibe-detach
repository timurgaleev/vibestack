#!/usr/bin/env bash
# vibe-detach — run a long command past the end of the turn, and poll it later.
#
# A long eval suite or a slow build started in the foreground dies at the turn
# boundary, and its result dies with it: the work is paid for and thrown away,
# and the next turn cannot tell "it failed" from "it never finished". This
# starts the command detached from the session, captures its output and its
# exit status to disk, and hands back an id to ask about afterwards.
#
# Usage:
#   vibe-detach start [--label L] -- <cmd...>   # prints the job id
#   vibe-detach status <id>                     # running | exit:<n> | died
#   vibe-detach log <id> [--tail N]
#   vibe-detach list
#
# `status` exits 0 only when the job finished with exit 0, so a gate can be a
# plain `if`. A job still running exits 2 (not 1) — "not done yet" and "failed"
# are different answers and a caller that conflates them reports a running job
# as a failure.
#
# State lives under $VIBESTACK_HOME/jobs/<id>/. Nothing is cleaned up
# automatically: a result that vanishes on a timer is the problem this exists to
# fix. Remove a job directory by hand when you are done with it.
set -euo pipefail

VIBESTACK_HOME="${VIBESTACK_HOME:-$HOME/.vibestack}"
JOBS="$VIBESTACK_HOME/jobs"

usage() { sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'; }

job_dir() { # job_dir ID
  case "$1" in
    */*|.|..|"") echo "vibe-detach: invalid job id: $1" >&2; exit 2 ;;
  esac
  printf '%s/%s' "$JOBS" "$1"
}

cmd_start() {
  local label=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --label) label="${2:-}"; shift 2 ;;
      --) shift; break ;;
      *) echo "vibe-detach: unexpected argument: $1" >&2; exit 2 ;;
    esac
  done
  [ $# -gt 0 ] || { echo "vibe-detach start: nothing after --" >&2; exit 2; }

  local id dir
  id="j$(date -u +%Y%m%dT%H%M%S)$$"
  dir="$JOBS/$id"
  mkdir -p "$dir"

  printf '%s\n' "${label:-$1}" > "$dir/label"
  printf '%s\n' "$*"           > "$dir/cmd"
  date -u +'%Y-%m-%dT%H:%M:%SZ' > "$dir/started"

  # The command is written into a runner script with printf %q rather than
  # re-parsed from a string. An argument containing a space, a quote or a
  # semicolon would otherwise be re-split by the shell that runs it -- which
  # turns a filename with a space into two arguments, and a semicolon into a
  # second command.
  {
    printf '#!/usr/bin/env bash\n'
    printf 'cd %q || exit 127\n' "$PWD"
    printf '%q ' "$@"
    printf '\n'
    # $? is captured on the very next line, before anything else can overwrite
    # it. The write is to a temp file and renamed, so a reader never sees a
    # half-written status and mistakes it for a result.
    printf 'printf %%s "$?" > %q.tmp && mv %q.tmp %q\n' \
      "$dir/exit" "$dir/exit" "$dir/exit"
  } > "$dir/run.sh"
  chmod +x "$dir/run.sh"

  # setsid detaches from the controlling terminal outright where it exists
  # (Linux); macOS ships no setsid, and nohup plus a background subshell is
  # enough there. stdin comes from /dev/null so the job can never block waiting
  # on a terminal that is gone.
  if command -v setsid >/dev/null 2>&1; then
    setsid nohup "$dir/run.sh" > "$dir/out" 2>&1 < /dev/null &
  else
    nohup "$dir/run.sh" > "$dir/out" 2>&1 < /dev/null &
  fi
  printf '%s\n' "$!" > "$dir/pid"
  disown 2>/dev/null || true

  printf '%s\n' "$id"
}

cmd_status() {
  local dir; dir=$(job_dir "${1:?vibe-detach status: job id required}")
  [ -d "$dir" ] || { echo "vibe-detach: no such job: $1" >&2; exit 2; }

  if [ -f "$dir/exit" ]; then
    local code; code=$(cat "$dir/exit")
    printf 'exit:%s\n' "$code"
    [ "$code" = 0 ] && return 0 || return 1
  fi

  local pid; pid=$(cat "$dir/pid" 2>/dev/null || echo "")
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    echo "running"
    return 2
  fi
  # No status file and no live process: the job was killed before it could
  # record anything. Reported distinctly -- calling it a failure would be a
  # guess, and calling it success would be a lie.
  echo "died"
  return 1
}

cmd_log() {
  local id="${1:?vibe-detach log: job id required}"; shift || true
  local dir; dir=$(job_dir "$id")
  [ -d "$dir" ] || { echo "vibe-detach: no such job: $id" >&2; exit 2; }
  local n=0
  [ "${1:-}" = "--tail" ] && n="${2:-50}"
  if [ "$n" -gt 0 ] 2>/dev/null; then tail -n "$n" "$dir/out" 2>/dev/null || true
  else cat "$dir/out" 2>/dev/null || true; fi
}

cmd_list() {
  [ -d "$JOBS" ] || { echo "no jobs"; return 0; }
  local found=0 dir id st
  for dir in "$JOBS"/*/; do
    [ -d "$dir" ] || continue
    found=1
    id=$(basename "$dir")
    st=$(cmd_status "$id" || true)
    printf '%-24s %-10s %s\n' "$id" "$st" "$(cat "$dir/label" 2>/dev/null || echo '?')"
  done
  [ "$found" = 1 ] || echo "no jobs"
}

case "${1:-}" in
  start)  shift; cmd_start "$@" ;;
  status) shift; cmd_status "$@" ;;
  log)    shift; cmd_log "$@" ;;
  list)   shift; cmd_list "$@" ;;
  -h|--help|"") usage; [ -n "${1:-}" ] && exit 0 || exit 1 ;;
  *) echo "vibe-detach: unknown subcommand: $1" >&2; exit 2 ;;
esac
