#!/usr/bin/env bash
# vibe-question-log — append an AskUserQuestion event to the project's question-log.jsonl
#
# Usage:
#   vibe-question-log '{"skill":"ship","question_id":"ship:test-failure-triage",
#     "question_summary":"Tests failed","options_count":3,"user_choice":"fix-now",
#     "recommended":"fix-now"}'
#
# /plan-tune reads this log to show what it asked, how often, and how often the
# user overrode the recommendation. Nothing else consumes it, and nothing is
# sent anywhere — the file stays under ~/.vibestack/projects/<slug>/.
#
# Schema:
#   skill                   — skill name (kebab-case)                 [required]
#   question_id             — registered id, or `<skill>:<slug>`      [required]
#   question_summary        — one-liner of what was asked, <=200 chars
#   category                — approval | clarification | routing | cherry-pick | feedback-loop
#   door_type               — one-way | two-way
#   options_count           — number of options presented (positive integer)
#   user_choice             — option key the user selected
#   recommended             — option key the agent recommended
#   followed_recommendation — bool; computed when user_choice and recommended are both present
#   ts                      — ISO 8601, injected when missing
set -euo pipefail
# bash 5.2+ writes a heredoc under 64 KiB into a pipe and can hang on a small macOS pipe;
# compat 5.0 keeps the temp file (test/test-heredoc-compat.sh).
[ "${BASH_VERSINFO[0]}" -lt 5 ] || BASH_COMPAT=50

if [ $# -eq 0 ]; then
  echo "Usage: vibe-question-log '<json>'" >&2
  exit 1
fi

JSON="$1"

eval "$(bash "$(dirname "$0")/vibe-slug" 2>/dev/null)" 2>/dev/null || SLUG="unknown"

VIBESTACK_HOME="${VIBESTACK_HOME:-$HOME/.vibestack}"
LOG_DIR="$VIBESTACK_HOME/projects/${SLUG:-unknown}"
mkdir -p "$LOG_DIR"

TS=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

# The payload arrives on argv, so it is passed to python as an argument rather
# than interpolated into the program text — a question summary containing a
# quote or a newline must not be able to rewrite the script.
ENTRY=$(LOG_TS="$TS" python3 -I - "$JSON" <<'PYEOF'
import json, os, re, sys

try:
    entry = json.loads(sys.argv[1])
except (ValueError, IndexError):
    sys.stderr.write("Error: invalid JSON\n")
    sys.exit(1)

if not isinstance(entry, dict):
    sys.stderr.write("Error: payload must be a JSON object\n")
    sys.exit(1)

for field in ("skill", "question_id"):
    if not entry.get(field):
        sys.stderr.write("Error: missing required field: %s\n" % field)
        sys.exit(1)

VALID_CATEGORY = {"approval", "clarification", "routing", "cherry-pick", "feedback-loop"}
VALID_DOOR = {"one-way", "two-way"}

if entry.get("category") and entry["category"] not in VALID_CATEGORY:
    sys.stderr.write("Error: category must be one of %s\n" % ", ".join(sorted(VALID_CATEGORY)))
    sys.exit(1)
if entry.get("door_type") and entry["door_type"] not in VALID_DOOR:
    sys.stderr.write("Error: door_type must be one-way or two-way\n")
    sys.exit(1)

# --- secret patterns: begin (same labels and placeholder rules as bin/vibe-redact-prepush;
# lib/snippets/secret-scan-patterns.md is the canonical list, test-redact-scan.sh keeps them equal)
SECRET_PATTERNS = [
    ("AWS access key", r"AKIA[0-9A-Z]{16}"),
    ("AWS temporary key", r"ASIA[0-9A-Z]{16}"),
    ("GitHub token", r"gh(p|o|s|u|r)_[A-Za-z0-9]{36}"),
    ("GitHub fine-grained token", r"github_pat_[A-Za-z0-9_]{22,}"),
    ("Slack token", r"xox[abpr]-[A-Za-z0-9-]{10,}"),
    ("Stripe live key", r"(sk|rk)_live_[A-Za-z0-9]{20,}"),
    ("Google API key", r"AIza[0-9A-Za-z_-]{35}"),
    ("Anthropic key", r"sk-ant-[A-Za-z0-9_-]{20,}"),
    ("OpenAI key (modern)", r"sk-(proj|svcacct|admin)-[A-Za-z0-9_-]{20,}"),
    ("OpenAI key (classic)", r"sk-[A-Za-z0-9]{48}"),
    ("GitLab token", r"gl(pat|ptt|dt)-[A-Za-z0-9_-]{20,}"),
    ("HuggingFace token", r"hf_[A-Za-z0-9]{30,}"),
    ("npm token", r"npm_[A-Za-z0-9]{36}"),
    ("DigitalOcean token", r"dop_v1_[a-f0-9]{64}"),
    ("Private key block", r"-----BEGIN[^-\n]*PRIVATE KEY-----"),
    ("AWS secret key", r"aws_secret_access_key[^A-Za-z0-9\n]+[A-Za-z0-9/+=]{40}"),
    ("SecretAccessKey field", r"\"?SecretAccessKey\"?[ \t]*[:=][ \t]*\"?[A-Za-z0-9/+=]{40}"),
    ("env-style secret", r"^[ \t+-]{0,2}[ \t]*(-[ \t]+)?(export[ \t]+)?[A-Z][A-Z0-9_]*_(KEY|TOKEN|SECRET|PASSWORD)(=..+|[ \t]+=[ \t]*(\x22[^\x22\n]{2,}\x22|\x27[^\x27\n]{2,}\x27))"),
    ("DSN credentials", r"://[^\s:/@]{0,255}:[^\s@/]{1,255}@"),
]
_SECRET_RES = [(label, re.compile(pat, re.M)) for label, pat in SECRET_PATTERNS]
_BEARER = re.compile(r"Bearer[ \t]+([A-Za-z0-9._~+/=-]{20,})")


def _secret_placeholder(label, span):
    v = span
    if label == "env-style secret":
        # Judge the first shell word only, so `KEY=$1  # arg` or
        # `KEY="$1";` is the expansion it looks like.
        v = span.split("=", 1)[1].lstrip()
        if v[:1] in ('"', "'"):
            v = v[1:].split(v[0], 1)[0]
        else:
            v = re.split(r"[\s;]", v, maxsplit=1)[0]
    elif label == "SecretAccessKey field":
        v = re.split(r"[:=]", span, maxsplit=1)[1].lstrip()
    elif label == "DSN credentials":
        v = span[3:].split(":", 1)[1][:-1]
    for q in ('"', "'"):
        v = v[1:] if v.startswith(q) else v
        v = v[:-1] if v.endswith(q) else v
    if re.match(r"(your[_-]|<[^>]*>$|[*]+$|x{6,}$|changeme$|redacted|placeholder|dummy|fake)", v, re.I):
        return True
    # A bare $NAME is a reference only in one case ($API_KEY, $token); a
    # mixed-case run after the "$" ($ecretP4ss) is a value that starts with one.
    if re.fullmatch(r"\$(\{?([A-Z_][A-Z0-9_]*|[a-z_][a-z0-9_]*)\}?|[0-9@*#])", v):
        return True
    if re.match(r"[$][({]", v):
        return True
    # A short stub before "..." (sk-..., ghp_..., AKIA...) is a placeholder; a
    # long value, or a short one that mixes case or carries a digit with no
    # separator (P4ss..., hunter2...), is still a value.
    if v.endswith("..."):
        s = v[:-3]
        mixed = re.search(r"[A-Z]", s) and re.search(r"[a-z]", s)
        if len(s) <= 8 and not mixed and (re.search(r"[-_]", s) or not re.search(r"[0-9]", s)):
            return True
    if label == "DSN credentials" and ("\x24{" in v or "\x24(" in v or len(v) < 8 or re.fullmatch(
            r"pass|password|postgres|root|test|secret|admin|change-?me|p", v, re.I)
            or v == span[3:].split(":", 1)[0]):
        return True
    if "://" in v or "@" in v:
        return False
    return re.search(r"^example|example(key)?$", v, re.I) is not None


def find_secret(text):
    """Label of the first high-confidence secret in text, or None."""
    for label, rx in _SECRET_RES:
        for m in rx.finditer(text):
            if not _secret_placeholder(label, m.group(0)):
                return label
    for m in _BEARER.finditer(text):
        tok = m.group(1)
        if (re.search(r"[0-9]", tok) and re.search(r"[a-z]", tok) and re.search(r"[A-Z]", tok)
                and not _secret_placeholder("Bearer token", tok)):
            return "Bearer token"
    return None


def secret_in_payload(raw, obj):
    """Scan the raw JSON and every decoded key and string, one per line, so an
    env-style line or a quoted field inside a value is seen as written."""
    parts = [raw]

    def walk(x):
        if isinstance(x, str):
            parts.append(x)
        elif isinstance(x, dict):
            for k, v in x.items():
                parts.append(str(k))
                walk(v)
        elif isinstance(x, list):
            for v in x:
                walk(v)

    walk(obj)
    return find_secret("\n".join(parts))
# --- secret patterns: end ---

# Summaries quote what the user was asked, which can include a pasted credential.
found = secret_in_payload(sys.argv[1], entry)
if found:
    sys.stderr.write("Error: entry carries a high-confidence secret (%s); not recorded\n" % found)
    sys.exit(1)

summary = entry.get("question_summary")
if isinstance(summary, str) and len(summary) > 200:
    entry["question_summary"] = summary[:197] + "..."

# The whole point of the log is the follow/override ratio, so derive it here
# rather than trusting every caller to compute it the same way.
if "followed_recommendation" not in entry and entry.get("user_choice") and entry.get("recommended"):
    entry["followed_recommendation"] = entry["user_choice"] == entry["recommended"]

entry.setdefault("ts", os.environ["LOG_TS"])

print(json.dumps(entry, separators=(",", ":")))
PYEOF
)

printf '%s\n' "$ENTRY" >> "$LOG_DIR/question-log.jsonl"
