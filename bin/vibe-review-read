#!/usr/bin/env python3
"""vibe-review-read — read the branch review log for the readiness dashboard.

Usage:
  vibe-review-read                 human summary of this branch's review entries
  vibe-review-read --json          raw entries as a JSON array
  vibe-review-read --skill review  only entries for one skill (latest first)

Reads ``$VIBESTACK_HOME/projects/<slug>/<branch>-reviews.jsonl`` (written by
vibe-review-log). Prints ``NO_REVIEWS`` when the log is absent — callers gate on
that instead of guessing OFFLINE. Latest entry per skill wins in the summary.
"""
import json
import os
import re
import subprocess
import sys

HOME = os.environ.get("VIBESTACK_HOME", os.path.expanduser("~/.vibestack"))


def _run(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout.strip()
    except Exception:
        return ""


def slug() -> str:
    here = os.path.dirname(os.path.abspath(__file__))
    m = re.search(r"SLUG=([^\s]+)", _run([os.path.join(here, "vibe-slug")]))
    return m.group(1) if m else "unknown"


def branch() -> str:
    return _run(["git", "branch", "--show-current"]) or "unknown"


def load():
    path = os.path.join(HOME, "projects", slug(), f"{branch()}-reviews.jsonl")
    if not os.path.isfile(path):
        return None
    rows = []
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                rows.append(json.loads(line))
            except Exception:
                continue
    return rows


def main() -> int:
    args = sys.argv[1:]
    rows = load()
    if rows is None:
        print("NO_REVIEWS")
        return 0

    only = None
    if "--skill" in args:
        i = args.index("--skill")
        only = args[i + 1] if i + 1 < len(args) else None
    if only:
        rows = [r for r in rows if r.get("skill") == only]

    if "--json" in args:
        print(json.dumps(rows, ensure_ascii=False, indent=2))
        return 0

    if not rows:
        print("NO_REVIEWS")
        return 0

    # Latest entry per skill for the dashboard.
    latest = {}
    for r in rows:
        latest[r.get("skill", "?")] = r
    for sk in sorted(latest):
        r = latest[sk]
        extras = " ".join(
            f"{k}={r[k]}" for k in ("issues_found", "critical", "findings", "auto_fixed",
                                    "quality_score", "coverage_pct") if k in r)
        print(f"{sk:24} {r.get('status','?'):8} {r.get('timestamp','')[:19]}  {extras}".rstrip())
    return 0


if __name__ == "__main__":
    sys.exit(main())
