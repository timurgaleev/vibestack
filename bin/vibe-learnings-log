#!/usr/bin/env bash
# vibe-learnings-log — append a learning entry to the project's learnings.jsonl
# Usage: vibe-learnings-log '<json>'
#        vibe-learnings-log --forget KEY TYPE   remove every entry for KEY of TYPE
# JSON schema: {"skill":"<name>","type":"<type>","key":"<key>","insight":"<text>","confidence":<1-10>,"source":"<src>","files":[...]}
set -euo pipefail
# bash 5.2+ writes a heredoc under 64 KiB into a pipe and can hang on a small macOS pipe;
# compat 5.0 keeps the temp file (test/test-heredoc-compat.sh).
[ "${BASH_VERSINFO[0]}" -lt 5 ] || BASH_COMPAT=50

if [ $# -eq 0 ]; then
  echo "Usage: vibe-learnings-log '<json>'" >&2
  exit 1
fi

JSON="$1"

# Derive SLUG
eval "$(bash "$(dirname "$0")/vibe-slug" 2>/dev/null)" 2>/dev/null || SLUG="unknown"

VIBESTACK_HOME="${VIBESTACK_HOME:-$HOME/.vibestack}"
LEARN_DIR="$VIBESTACK_HOME/projects/$SLUG"
mkdir -p "$LEARN_DIR"

LEARN_FILE="$LEARN_DIR/learnings.jsonl"

# /learn prune removes through here, so the rewrite is a filter, not a file the
# model retypes. Updates are appended, so one key+type can hold several lines;
# every one goes. Lines that do not parse are kept as they are.
if [ "$JSON" = "--forget" ]; then
  [ $# -eq 3 ] || { echo "Usage: vibe-learnings-log --forget KEY TYPE" >&2; exit 1; }
  [ -f "$LEARN_FILE" ] || { echo "Forgot 0 entries (no learnings file)"; exit 0; }
  python3 -I - "$LEARN_FILE" "$2" "$3" <<'PYEOF'
import json, os, re, sys, tempfile
path, key, etype = sys.argv[1:4]
if not re.fullmatch(r"[A-Za-z0-9._-]{1,80}", key) or not re.fullmatch(r"[a-z-]{1,40}", etype):
    sys.stderr.write("Error: KEY must be 1-80 of [A-Za-z0-9._-], TYPE a lowercase type name\n")
    sys.exit(1)
kept, dropped = [], 0
with open(path, encoding="utf-8", errors="surrogateescape") as f:
    for line in f:
        try:
            e = json.loads(line)
        except ValueError:
            e = None
        if isinstance(e, dict) and e.get("key") == key and e.get("type") == etype:
            dropped += 1
        else:
            kept.append(line if line.endswith("\n") else line + "\n")
if dropped:
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".learnings.")
    with os.fdopen(fd, "w", encoding="utf-8", errors="surrogateescape") as out:
        out.writelines(kept)
    os.chmod(tmp, os.stat(path).st_mode & 0o777)
    os.replace(tmp, path)
print(f"Forgot {dropped} entries ({etype} / {key})")
PYEOF
  exit $?
fi

# Inject timestamp, branch, commit if not present
BRANCH=$(git branch --show-current 2>/dev/null || echo "")
COMMIT=$(git rev-parse --short HEAD 2>/dev/null || echo "")
TS=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

# The payload arrives on argv and is passed to python as an ARGUMENT, never
# interpolated into the program text. It used to be pasted between triple
# quotes inside an unquoted heredoc, which meant python's string literal ate
# the payload's own backslashes: an insight containing a double quote, a
# backslash, a newline, or a triple quote arrived as broken JSON and the
# learning was lost. A separate validation step read the same payload
# correctly from stdin, so the tool checked one thing and then processed
# another, and the failure surfaced only as a traceback.
ENTRY=$(VIBE_TS="$TS" VIBE_BRANCH="$BRANCH" VIBE_COMMIT="$COMMIT" \
  python3 -I - "$JSON" <<'PYEOF'
import json, os, re, sys

try:
    entry = json.loads(sys.argv[1])
except (ValueError, IndexError):
    sys.stderr.write("Error: invalid JSON\n")
    sys.exit(1)

if not isinstance(entry, dict):
    sys.stderr.write("Error: payload must be a JSON object\n")
    sys.exit(1)

def reject(msg):
    sys.stderr.write(f"Error: {msg}; learning not recorded\n")
    sys.exit(1)

# --- secret patterns: begin (same labels and placeholder rules as bin/vibe-redact-prepush;
# lib/snippets/secret-scan-patterns.md is the canonical list, test-redact-scan.sh keeps them equal)
SECRET_PATTERNS = [
    ("AWS access key", r"AKIA[0-9A-Z]{16}"),
    ("AWS temporary key", r"ASIA[0-9A-Z]{16}"),
    ("GitHub token", r"gh(p|o|s|u|r)_[A-Za-z0-9]{36}"),
    ("GitHub fine-grained token", r"github_pat_[A-Za-z0-9_]{22,}"),
    ("Slack token", r"xox[abpr]-[A-Za-z0-9-]{10,}"),
    ("Stripe live key", r"(sk|rk)_live_[A-Za-z0-9]{20,}"),
    ("Google API key", r"AIza[0-9A-Za-z_-]{35}"),
    ("Anthropic key", r"sk-ant-[A-Za-z0-9_-]{20,}"),
    ("OpenAI key (modern)", r"sk-(proj|svcacct|admin)-[A-Za-z0-9_-]{20,}"),
    ("OpenAI key (classic)", r"sk-[A-Za-z0-9]{48}"),
    ("GitLab token", r"gl(pat|ptt|dt)-[A-Za-z0-9_-]{20,}"),
    ("HuggingFace token", r"hf_[A-Za-z0-9]{30,}"),
    ("npm token", r"npm_[A-Za-z0-9]{36}"),
    ("DigitalOcean token", r"dop_v1_[a-f0-9]{64}"),
    ("Private key block", r"-----BEGIN[^-\n]*PRIVATE KEY-----"),
    ("AWS secret key", r"aws_secret_access_key[^A-Za-z0-9\n]+[A-Za-z0-9/+=]{40}"),
    ("SecretAccessKey field", r"\"?SecretAccessKey\"?[ \t]*[:=][ \t]*\"?[A-Za-z0-9/+=]{40}"),
    ("env-style secret", r"^[ \t+-]{0,2}[ \t]*(-[ \t]+)?(export[ \t]+)?[A-Z][A-Z0-9_]*_(KEY|TOKEN|SECRET|PASSWORD)=..+"),
    ("DSN credentials", r"://[^\s:/@]{0,255}:[^\s@/]{1,255}@"),
]
_SECRET_RES = [(label, re.compile(pat, re.M)) for label, pat in SECRET_PATTERNS]
_BEARER = re.compile(r"Bearer[ \t]+([A-Za-z0-9._~+/=-]{20,})")


def _secret_placeholder(label, span):
    v = span
    if label == "env-style secret":
        v = span.split("=", 1)[1]
    elif label == "SecretAccessKey field":
        v = re.split(r"[:=]", span, maxsplit=1)[1].lstrip()
    elif label == "DSN credentials":
        v = span[3:].split(":", 1)[1][:-1]
    for q in ('"', "'"):
        v = v[1:] if v.startswith(q) else v
        v = v[:-1] if v.endswith(q) else v
    if re.match(r"(your[_-]|<[^>]*>$|[*]+$|x{6,}$|changeme$|redacted|placeholder|dummy|fake)", v, re.I):
        return True
    if re.fullmatch(r"\$(\{?[A-Za-z_][A-Za-z0-9_]*\}?|[0-9@*#])", v):
        return True
    # A short stub before "..." (sk-..., ghp_...) is a placeholder; a long
    # value with dots on the end is still a value.
    if re.match(r"[$][({]", v) or (v.endswith("...") and len(v) <= 11):
        return True
    if label == "DSN credentials" and ("\x24{" in v or "\x24(" in v or len(v) < 8 or re.fullmatch(
            r"pass|password|postgres|root|test|secret|admin|change-?me|p", v, re.I)
            or v == span[3:].split(":", 1)[0]):
        return True
    if "://" in v or "@" in v:
        return False
    return re.search(r"^example|example(key)?$", v, re.I) is not None


def find_secret(text):
    """Label of the first high-confidence secret in text, or None."""
    for label, rx in _SECRET_RES:
        for m in rx.finditer(text):
            if not _secret_placeholder(label, m.group(0)):
                return label
    for m in _BEARER.finditer(text):
        tok = m.group(1)
        if (re.search(r"[0-9]", tok) and re.search(r"[a-z]", tok) and re.search(r"[A-Z]", tok)
                and not _secret_placeholder("Bearer token", tok)):
            return "Bearer token"
    return None


def secret_in_payload(raw, obj):
    """Scan the raw JSON and every decoded key and string, one per line, so an
    env-style line or a quoted field inside a value is seen as written."""
    parts = [raw]

    def walk(x):
        if isinstance(x, str):
            parts.append(x)
        elif isinstance(x, dict):
            for k, v in x.items():
                parts.append(str(k))
                walk(v)
        elif isinstance(x, list):
            for v in x:
                walk(v)

    walk(obj)
    return find_secret("\n".join(parts))
# --- secret patterns: end ---

found = secret_in_payload(sys.argv[1], entry)
if found:
    reject(f"payload carries a high-confidence secret ({found}); redact and rotate it")

# Every logged insight is replayed into later sessions' context, so the store is
# a standing prompt-injection surface. Fields are validated here and
# instruction-shaped insights are refused rather than persisted.
TYPES = ("pattern", "pitfall", "preference", "architecture", "tool",
         "operational", "investigation", "taste")
# design-shotgun records a user's approval or rejection of a variant.
SOURCES = ("observed", "user-stated", "inferred", "cross-model", "design-shotgun")
INJECTION = re.compile(
    r"ignore\s+(all\s+)?(the\s+)?(previous|prior|above)\s+(instructions|context|rules)"
    r"|disregard\s+(all\s+)?(the\s+)?(previous|prior|above)"
    r"|\byou\s+are\s+now\b"
    r"|\bfrom\s+now\s+on\b"
    r"|\bnew\s+instructions?\b"
    r"|\bsystem\s+prompt\b"
    r"|\boverride\s+(all\s+)?(previous|prior|above|the\s+(rules|instructions))"
    r"|\bskip\s+(all\s+)?(the\s+)?(security|review|checks|tests)\b"
    r"|always\s+output\s+no\s+findings"
    r"|\bdo\s+not\s+(report|flag|mention)\b"
    r"|\bapprove\s+(all|every|this)\b"
    r"|</?(system|assistant|user)>"
    r"|^\s*(system|assistant|user|human)\s*:",
    re.IGNORECASE | re.MULTILINE,
)

etype = entry.get("type")
if etype not in TYPES:
    reject(f"type must be one of {', '.join(TYPES)} (got {etype!r})")

key = entry.get("key")
if not isinstance(key, str) or not re.fullmatch(r"[A-Za-z0-9._-]{1,80}", key):
    reject("key must be 1-80 characters of letters, digits, '.', '_' or '-'")

insight = entry.get("insight")
if not isinstance(insight, str) or not insight.strip():
    reject("insight must be a non-empty string")
m = INJECTION.search(insight)
if m:
    reject(f"insight reads as an instruction to the agent ({m.group(0).strip()!r})")

conf = entry.get("confidence", 5)
if isinstance(conf, str) and conf.strip().isdigit():
    conf = int(conf.strip())
if isinstance(conf, bool) or not isinstance(conf, int) or not 1 <= conf <= 10:
    reject(f"confidence must be an integer 1-10 (got {entry.get('confidence')!r})")
entry["confidence"] = conf

source = entry.get("source", "inferred")
if source not in SOURCES:
    reject(f"source must be one of {', '.join(SOURCES)} (got {source!r})")
entry["source"] = source

files = entry.get("files", [])
if not isinstance(files, list) or not all(isinstance(f, str) for f in files):
    reject("files must be a list of path strings")

# Trust is derived, never taken from the payload: only what the user said
# outright may cross into other projects' searches.
entry["trusted"] = source == "user-stated"

entry.setdefault("ts", os.environ["VIBE_TS"])
entry.setdefault("branch", os.environ["VIBE_BRANCH"])
entry.setdefault("commit", os.environ["VIBE_COMMIT"])
entry["files"] = files

# separators keep the entry on one line -- the store is JSONL, and a pretty
# printed entry would break every reader that splits on newlines.
print(json.dumps(entry, separators=(',', ':')))
PYEOF
) || exit 1

echo "$ENTRY" >> "$LEARN_FILE"
echo "Logged: $(echo "$ENTRY" | python3 -I -c "import sys,json; e=json.load(sys.stdin); print(f\"{e.get('type','?')} / {e.get('key','?')} (confidence {e.get('confidence','?')}/10)\")")"
