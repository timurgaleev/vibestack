#!/usr/bin/env bash
# vibe-learnings-log — append a learning entry to the project's learnings.jsonl
# Usage: vibe-learnings-log '<json>'
# JSON schema: {"skill":"<name>","type":"<type>","key":"<key>","insight":"<text>","confidence":<1-10>,"source":"<src>","files":[...]}
set -euo pipefail

if [ $# -eq 0 ]; then
  echo "Usage: vibe-learnings-log '<json>'" >&2
  exit 1
fi

JSON="$1"

# Derive SLUG
eval "$(bash "$(dirname "$0")/vibe-slug" 2>/dev/null)" 2>/dev/null || SLUG="unknown"

VIBESTACK_HOME="${VIBESTACK_HOME:-$HOME/.vibestack}"
LEARN_DIR="$VIBESTACK_HOME/projects/$SLUG"
mkdir -p "$LEARN_DIR"

LEARN_FILE="$LEARN_DIR/learnings.jsonl"

# Inject timestamp, branch, commit if not present
BRANCH=$(git branch --show-current 2>/dev/null || echo "")
COMMIT=$(git rev-parse --short HEAD 2>/dev/null || echo "")
TS=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

# The payload arrives on argv and is passed to python as an ARGUMENT, never
# interpolated into the program text. It used to be pasted between triple
# quotes inside an unquoted heredoc, which meant python's string literal ate
# the payload's own backslashes: an insight containing a double quote, a
# backslash, a newline, or a triple quote arrived as broken JSON and the
# learning was lost. A separate validation step read the same payload
# correctly from stdin, so the tool checked one thing and then processed
# another, and the failure surfaced only as a traceback.
ENTRY=$(VIBE_TS="$TS" VIBE_BRANCH="$BRANCH" VIBE_COMMIT="$COMMIT" \
  python3 - "$JSON" <<'PYEOF'
import json, os, re, sys

try:
    entry = json.loads(sys.argv[1])
except (ValueError, IndexError):
    sys.stderr.write("Error: invalid JSON\n")
    sys.exit(1)

if not isinstance(entry, dict):
    sys.stderr.write("Error: payload must be a JSON object\n")
    sys.exit(1)

def reject(msg):
    sys.stderr.write(f"Error: {msg}; learning not recorded\n")
    sys.exit(1)

# Every logged insight is replayed into later sessions' context, so the store is
# a standing prompt-injection surface. Fields are validated here and
# instruction-shaped insights are refused rather than persisted.
TYPES = ("pattern", "pitfall", "preference", "architecture", "tool",
         "operational", "investigation", "taste")
# design-shotgun records a user's approval or rejection of a variant.
SOURCES = ("observed", "user-stated", "inferred", "cross-model", "design-shotgun")
INJECTION = re.compile(
    r"ignore\s+(all\s+)?(the\s+)?(previous|prior|above)\s+(instructions|context|rules)"
    r"|disregard\s+(all\s+)?(the\s+)?(previous|prior|above)"
    r"|\byou\s+are\s+now\b"
    r"|\bfrom\s+now\s+on\b"
    r"|\bnew\s+instructions?\b"
    r"|\bsystem\s+prompt\b"
    r"|\boverride\s+(all\s+)?(previous|prior|above|the\s+(rules|instructions))"
    r"|\bskip\s+(all\s+)?(the\s+)?(security|review|checks|tests)\b"
    r"|always\s+output\s+no\s+findings"
    r"|\bdo\s+not\s+(report|flag|mention)\b"
    r"|\bapprove\s+(all|every|this)\b"
    r"|</?(system|assistant|user)>"
    r"|^\s*(system|assistant|user|human)\s*:",
    re.IGNORECASE | re.MULTILINE,
)

etype = entry.get("type")
if etype not in TYPES:
    reject(f"type must be one of {', '.join(TYPES)} (got {etype!r})")

key = entry.get("key")
if not isinstance(key, str) or not re.fullmatch(r"[A-Za-z0-9._-]{1,80}", key):
    reject("key must be 1-80 characters of letters, digits, '.', '_' or '-'")

insight = entry.get("insight")
if not isinstance(insight, str) or not insight.strip():
    reject("insight must be a non-empty string")
m = INJECTION.search(insight)
if m:
    reject(f"insight reads as an instruction to the agent ({m.group(0).strip()!r})")

conf = entry.get("confidence", 5)
if isinstance(conf, str) and conf.strip().isdigit():
    conf = int(conf.strip())
if isinstance(conf, bool) or not isinstance(conf, int) or not 1 <= conf <= 10:
    reject(f"confidence must be an integer 1-10 (got {entry.get('confidence')!r})")
entry["confidence"] = conf

source = entry.get("source", "inferred")
if source not in SOURCES:
    reject(f"source must be one of {', '.join(SOURCES)} (got {source!r})")
entry["source"] = source

files = entry.get("files", [])
if not isinstance(files, list) or not all(isinstance(f, str) for f in files):
    reject("files must be a list of path strings")

# Trust is derived, never taken from the payload: only what the user said
# outright may cross into other projects' searches.
entry["trusted"] = source == "user-stated"

entry.setdefault("ts", os.environ["VIBE_TS"])
entry.setdefault("branch", os.environ["VIBE_BRANCH"])
entry.setdefault("commit", os.environ["VIBE_COMMIT"])
entry["files"] = files

# separators keep the entry on one line -- the store is JSONL, and a pretty
# printed entry would break every reader that splits on newlines.
print(json.dumps(entry, separators=(',', ':')))
PYEOF
) || exit 1

echo "$ENTRY" >> "$LEARN_FILE"
echo "Logged: $(echo "$ENTRY" | python3 -c "import sys,json; e=json.load(sys.stdin); print(f\"{e.get('type','?')} / {e.get('key','?')} (confidence {e.get('confidence','?')}/10)\")")"
