#!/usr/bin/env bash
# vibe-diff-scope — categorize what changed in the diff against a base branch.
# Drives conditional specialist dispatch in /review and /ship and the
# canary-depth matrix in /land-and-deploy.
#
# Usage:
#   source <(vibe-diff-scope main)   # sets SCOPE_FRONTEND=true SCOPE_BACKEND=false …
#   vibe-diff-scope main             # prints SCOPE_*=… lines
#   vibe-diff-scope <sha>            # a commit works as the base too
#
# The scope is the diff from `git merge-base origin/<base> HEAD` (or <base> itself
# when there is no such remote ref) to the working tree, untracked files
# included — what /review reads and /ship commits. When git cannot produce it, the only line printed is
# SCOPE_UNAVAILABLE=true and the exit status is 2: an unknown scope must not
# read as "nothing changed".
set -euo pipefail
[ "${BASH_VERSINFO[0]}" -lt 5 ] || BASH_COMPAT=50

BASE="${1:-main}"

unavailable() { echo "SCOPE_UNAVAILABLE=true"; exit 2; }

BASE_REF=$(git rev-parse --verify --quiet "origin/${BASE}^{commit}" 2>/dev/null) \
  || BASE_REF=$(git rev-parse --verify --quiet "${BASE}^{commit}" 2>/dev/null) \
  || unavailable
MERGE_BASE=$(git merge-base "$BASE_REF" HEAD 2>/dev/null) || unavailable
# -z: plain output C-quotes unusual paths ("app/views/caf\303\251.html.erb"),
# which no glob below matches. --no-renames keeps a moved file's old path in
# scope, and --no-relative ignores a diff.relative setting when this runs from a
# subdirectory. Untracked files ship with the branch, so they count too.
FILES=$( { git diff -z --name-only --no-renames --no-relative "$MERGE_BASE" \
  && git ls-files -z --others --exclude-standard --full-name -- ':/'; } 2>/dev/null \
  | tr '\0' '\n') || unavailable

FRONTEND=false BACKEND=false PROMPTS=false TESTS=false DOCS=false
CONFIG=false MIGRATIONS=false API=false AUTH=false

# One case per category: a path sets every flag it matches. Matching ignores
# case so AuthController.php and UserSession.swift reach the auth and API globs.
shopt -s nocasematch
while IFS= read -r f; do
  [ -z "$f" ] && continue

  # Frontend: styles, components, templates, markup
  case "$f" in
    *.css|*.scss|*.less|*.sass|*.pcss|*.module.css|*.module.scss| \
    *.tsx|*.jsx|*.vue|*.svelte|*.astro| \
    *.erb|*.haml|*.slim|*.hbs|*.ejs|*.html| \
    tailwind.config.*|postcss.config.*| \
    app/views/*|components/*|*/components/*|styles/*|css/*|app/assets/stylesheets/*) FRONTEND=true ;;
  esac

  # Prompts: prompt builders, generation/eval services, system prompts
  case "$f" in
    *prompt_builder*|*generation_service*|*writer_service*|*designer_service*| \
    *evaluator*|*scorer*|*classifier_service*|*analyzer*| \
    *voice*.rb|*writing*.rb|*prompt*.rb|*token*.rb| \
    config/system_prompts/*) PROMPTS=true ;;
  esac

  # Tests
  case "$f" in
    *.test.*|*.spec.*|*_test.*|*_spec.*|test_*.py|*/test_*.py|*Test.java|*Tests.swift| \
    test/*|tests/*|spec/*|__tests__/*|cypress/*|e2e/*| \
    */test/*|*/tests/*|*/__tests__/*) TESTS=true ;;
  esac

  # Docs
  case "$f" in
    *.md) DOCS=true ;;
  esac

  # Config / lockfiles / CI
  case "$f" in
    package.json|package-lock.json|yarn.lock|bun.lock|bun.lockb| \
    Gemfile|Gemfile.lock|*.yml|*.yaml|.github/*| \
    requirements.txt|pyproject.toml|go.mod|Cargo.toml|composer.json) CONFIG=true ;;
  esac

  # Migrations
  case "$f" in
    db/migrate/*|*/migrations/*|alembic/*|prisma/migrations/*) MIGRATIONS=true ;;
  esac

  # API: routes, controllers, endpoints, schemas
  case "$f" in
    *controller*|*route*|*endpoint*|*/api/*| \
    *.graphql|*.gql|openapi.*|*/openapi.*|swagger.*|*/swagger.*) API=true ;;
  esac

  # Auth
  case "$f" in
    *auth*|*session*|*jwt*|*oauth*|*permission*|*role*|*token*) AUTH=true ;;
  esac

  # Backend: any code. Include ESM/CJS + explicit-module TS so an ESM-only PR
  # never skips the backend reviewer.
  case "$f" in
    *.rb|*.py|*.go|*.rs|*.java|*.php|*.ex|*.exs| \
    *.ts|*.js|*.mjs|*.cjs|*.mts|*.cts| \
    *.kt|*.kts|*.swift|*.cs|*.dart|*.scala|*.c|*.cc|*.cpp|*.h| \
    *.sh|*.bash|*.zsh|bin/*|*/bin/*) BACKEND=true ;;
  esac
done <<< "$FILES"

echo "SCOPE_FRONTEND=$FRONTEND"
echo "SCOPE_BACKEND=$BACKEND"
echo "SCOPE_PROMPTS=$PROMPTS"
echo "SCOPE_TESTS=$TESTS"
echo "SCOPE_DOCS=$DOCS"
echo "SCOPE_CONFIG=$CONFIG"
echo "SCOPE_MIGRATIONS=$MIGRATIONS"
echo "SCOPE_API=$API"
echo "SCOPE_AUTH=$AUTH"
