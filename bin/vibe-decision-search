#!/usr/bin/env python3
"""vibe-decision-search — read active durable decisions for the current project.

Usage:
  vibe-decision-search [--recent N] [--query STR] [--all]

Folds the event log (decisions.jsonl) into the active set: a `supersede`/`redact`
event drops its target. Prints newest-first. `--query` filters by substring over
the decision + rationale; `--recent N` caps the count (default 10); `--all`
includes superseded/redacted (marked).
"""
import json
import os
import re
import subprocess
import sys

HOME = os.environ.get("VIBESTACK_HOME", os.path.expanduser("~/.vibestack"))


def slug() -> str:
    here = os.path.dirname(os.path.abspath(__file__))
    try:
        out = subprocess.run([os.path.join(here, "vibe-slug")],
                             capture_output=True, text=True, timeout=5).stdout
        m = re.search(r"SLUG=([^\s]+)", out)
        if m:
            return m.group(1)
    except Exception:
        pass
    return "unknown"


def flag(name: str, default=None):
    a = sys.argv[1:]
    return a[a.index(name) + 1] if name in a and a.index(name) + 1 < len(a) else default


def main() -> int:
    path = os.path.join(HOME, "projects", slug(), "decisions.jsonl")
    if not os.path.exists(path):
        print("no decisions logged yet")
        return 0

    decisions, dropped = {}, set()
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                ev = json.loads(line)
            except Exception:
                continue
            if ev.get("type") == "decide":
                decisions[ev["id"]] = ev
            elif ev.get("type") in ("supersede", "redact") and ev.get("target"):
                dropped.add(ev["target"])

    show_all = "--all" in sys.argv
    query = flag("--query")
    try:
        recent = int(flag("--recent", "10"))
    except ValueError:
        recent = 10

    rows = sorted(decisions.values(), key=lambda d: d.get("ts", ""), reverse=True)
    out = []
    for d in rows:
        inactive = d["id"] in dropped
        if inactive and not show_all:
            continue
        if query and query.lower() not in (d.get("decision", "") + d.get("rationale", "")).lower():
            continue
        tag = " [superseded]" if inactive else ""
        line = f"- {d['id']}{tag}: {d.get('decision', '')}"
        if d.get("rationale"):
            line += f"\n  why: {d['rationale']}"
        out.append(line)
        if len(out) >= recent:
            break

    print("\n".join(out) if out else "no active decisions")
    return 0


if __name__ == "__main__":
    sys.exit(main())
