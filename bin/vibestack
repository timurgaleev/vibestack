#!/usr/bin/env bash
# vibestack — umbrella CLI. One entry point for the vibe-* tools, in the same
# spirit as running `memrain` on the server: log in, type the name, get status
# and subcommands.
#
# Usage:
#   vibestack                  # status overview
#   vibestack help             # list subcommands
#   vibestack version          # installed pack version
#   vibestack skills [target]  # list installed skills (claude|cursor|kiro|codex)
#   vibestack doctor           # health check: bins, skills, state dirs
#   vibestack <tool> [args…]   # dispatch to vibe-<tool> (config, decision-log,
#                              # decision-search, learnings-search, slug, …)
set -uo pipefail

VIBE_HOME="${VIBESTACK_HOME:-$HOME/.vibestack}"
SELF_DIR="$(cd "$(dirname "$(realpath "$0" 2>/dev/null || echo "$0")")" && pwd)"

# Prefer sibling tools (repo checkout or installed bin), fall back to VIBE_HOME/bin.
tool_path() {
  local name="vibe-$1"
  if [ -x "$SELF_DIR/$name" ]; then printf '%s\n' "$SELF_DIR/$name"; return 0; fi
  if [ -x "$VIBE_HOME/bin/$name" ]; then printf '%s\n' "$VIBE_HOME/bin/$name"; return 0; fi
  return 1
}

pack_version() {
  # Repo checkout: VERSION sits one level above bin/. Installed: install drops
  # a copy at $VIBE_HOME/version.
  if [ -f "$SELF_DIR/../VERSION" ]; then tr -d '[:space:]' < "$SELF_DIR/../VERSION"
  elif [ -f "$VIBE_HOME/version" ]; then tr -d '[:space:]' < "$VIBE_HOME/version"
  else printf 'unknown'
  fi
  printf '\n'
}

skills_dir_for() {
  case "$1" in
    claude) printf '%s\n' "$HOME/.claude/skills" ;;
    cursor) printf '%s\n' "$HOME/.cursor/skills" ;;
    kiro)   printf '%s\n' "$HOME/.kiro/skills" ;;
    codex)  printf '%s\n' "$HOME/.agents/skills" ;;
    *)      return 1 ;;
  esac
}

cmd_skills() {
  local target="${1:-claude}" dir
  dir="$(skills_dir_for "$target")" || { echo "unknown target: $target (claude|cursor|kiro|codex)" >&2; return 1; }
  [ -d "$dir" ] || { echo "no skills installed for $target ($dir missing)"; return 1; }
  ls -1 "$dir"
}

cmd_status() {
  echo "vibestack $(pack_version)"
  echo "home:   $VIBE_HOME"
  local n
  for t in claude cursor kiro codex; do
    local d; d="$(skills_dir_for "$t")"
    if [ -d "$d" ]; then n=$(ls -1 "$d" 2>/dev/null | wc -l | tr -d ' '); echo "skills: $t $n"; fi
  done
  if [ -d "$VIBE_HOME/bin" ]; then
    n=$(ls -1 "$VIBE_HOME/bin"/vibe-* 2>/dev/null | wc -l | tr -d ' '); echo "tools:  $n installed"
  fi
  local uc; uc="$(tool_path update-check)" && "$uc" 2>/dev/null || true
}

# State root: writable, stamped with this pack's version, and carrying every
# tool the pack ships. Returns 1 only for a real failure.
doctor_state_root() {
  local bad=0 want have t missing=""
  [ -d "$VIBE_HOME" ] || return 0
  if [ -w "$VIBE_HOME" ]; then echo "  ok   home writable"; else echo "  FAIL home not writable ($VIBE_HOME)"; bad=1; fi
  if [ -f "$SELF_DIR/../VERSION" ]; then
    want="$(tr -d '[:space:]' < "$SELF_DIR/../VERSION")"
    have="$( [ -f "$VIBE_HOME/version" ] && tr -d '[:space:]' < "$VIBE_HOME/version" )"
    if [ "$have" = "$want" ]; then echo "  ok   version $want"
    else echo "  warn version ${have:-none} in $VIBE_HOME/version, pack is $want — re-run ./install"
    fi
  fi
  for t in "$SELF_DIR"/vibe-*; do
    [ -f "$t" ] || continue
    [ -x "$VIBE_HOME/bin/${t##*/}" ] || missing="$missing ${t##*/}"
  done
  if [ -n "$missing" ]; then echo "  MISS $VIBE_HOME/bin lacks:$missing — re-run ./install"; bad=1
  else echo "  ok   $VIBE_HOME/bin has every pack tool"
  fi
  return "$bad"
}

# Per installed target: the manifest is what lets a re-install prune a skill
# the pack withdrew.
doctor_manifests() {
  local t d
  for t in claude cursor kiro codex; do
    d="$(skills_dir_for "$t")"
    [ -d "$d" ] || continue
    if [ -f "$d/.vibestack-manifest" ]; then echo "  ok   $t skills manifest"
    else echo "  note $t has no install manifest — re-run ./install"
    fi
  done
}

# Optional CLIs. Absent is a note naming what stops working, never a failure.
doctor_runtimes() {
  local to="" row name why v
  if command -v timeout >/dev/null 2>&1; then to="timeout 3"
  elif command -v gtimeout >/dev/null 2>&1; then to="gtimeout 3"
  fi
  for row in "bun|full browse daemon" "node|browse shim" "codex|second-opinion skills" \
             "claude|second-opinion skills" "gh|PR skills (ship, land-and-deploy, address-pr-review)"; do
    name="${row%%|*}"; why="${row#*|}"
    if command -v "$name" >/dev/null 2>&1; then
      v="$($to "$name" --version 2>/dev/null | head -n1)"
      echo "  ok   $name ${v:-version unknown}"
    else
      echo "  note $name not installed — $why unavailable"
    fi
  done
  if [ -d "$VIBE_HOME/browse/node_modules" ]; then echo "  ok   browse deps $VIBE_HOME/browse"
  else echo "  note browse first-run setup pending"
  fi
}

cmd_doctor() {
  local bad=0
  echo "vibestack doctor"
  [ -d "$VIBE_HOME" ] && echo "  ok   home $VIBE_HOME" || { echo "  FAIL home missing ($VIBE_HOME) — run ./install"; bad=1; }
  for t in config slug session-kind repo-mode decision-log decision-search; do
    if tool_path "$t" >/dev/null; then echo "  ok   vibe-$t"; else echo "  MISS vibe-$t"; bad=1; fi
  done
  local d found=0
  for t in claude cursor kiro codex; do
    d="$(skills_dir_for "$t")"
    local n=0
    [ -d "$d" ] && n=$(ls -1 "$d" 2>/dev/null | wc -l | tr -d ' ')
    if [ "$n" -gt 0 ]; then
      echo "  ok   skills: $t ($n in $d)"; found=1
    fi
  done
  [ "$found" = 1 ] || { echo "  MISS no skills installed for any target — run ./install"; bad=1; }
  doctor_state_root || bad=1
  doctor_manifests
  doctor_runtimes
  case ":$PATH:" in
    *":$VIBE_HOME/bin:"*) echo "  ok   $VIBE_HOME/bin on PATH" ;;
    *) echo "  note $VIBE_HOME/bin not on PATH — add: export PATH=\"\$PATH:$VIBE_HOME/bin\"" ;;
  esac
  return "$bad"
}

cmd_help() {
  sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
  echo
  echo "Available tools (vibestack <name> …):"
  { ls -1 "$SELF_DIR"/vibe-* 2>/dev/null; ls -1 "$VIBE_HOME/bin"/vibe-* 2>/dev/null; } \
    | xargs -n1 basename 2>/dev/null | sed 's/^vibe-/  /' | sort -u || true
}

case "${1:-status}" in
  status)        cmd_status ;;
  help|-h|--help) cmd_help ;;
  version|-v|--version) pack_version ;;
  skills)        shift; cmd_skills "$@" ;;
  doctor)        cmd_doctor ;;
  *)
    name="$1"; shift
    if bin="$(tool_path "$name")"; then
      exec "$bin" "$@"
    else
      echo "vibestack: unknown command '$name' (try: vibestack help)" >&2
      exit 1
    fi
    ;;
esac
