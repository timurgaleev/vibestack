#!/usr/bin/env python3
"""vibe-review-log — append a review result to the branch review log.

Usage:
  vibe-review-log '{"skill":"review","status":"pass","issues_found":0,...}'
  vibe-review-log --snapshot      print the working-tree snapshot a review covers

Appends one line to ``$VIBESTACK_HOME/projects/<slug>/<branch>-reviews.jsonl``.
The Review Readiness Dashboard (/ship) and /retro read it via vibe-review-read.
Local and reliable — memrain is semantic recall, this is per-branch workflow state.

NON-INTERACTIVE — never prompts. A payload carrying a high-confidence secret is
rejected (exit 1), nothing written. `TIMESTAMP`/`COMMIT`/`STATUS` placeholders
left unsubstituted by a caller are filled in here (ts=now, commit=short HEAD).

Every entry records ``tree``: a snapshot of the working tree at log time —
tracked files and non-ignored untracked files, committed or not. Content alone
decides it, so committing the reviewed bytes leaves it unchanged, while any edit
moves it. A reader compares it with ``--snapshot`` to tell whether the tree
being shipped is the tree that was reviewed. Untracked files are included
because a review runs before anything is committed, when new files are not yet
added.

A caller that captured ``--snapshot`` before reading the diff passes it as
``start_tree``. A ``clean`` status is refused (exit 1, nothing written) when:
  - ``start_tree`` differs from the tree now: files changed after the review
    started (auto-fixes, user edits), and nothing reviewed those changes;
  - ``start_tree`` is set but the tree cannot be snapshotted now: an unknown
    tree is never taken as a match;
  - ``completed`` is false: a reviewer that was dispatched never finished, so
    the run has incomplete coverage, not zero findings;
  - ``converged`` is false: the fix/re-review loop hit its bound with edits
    still unreviewed.

A ``clean`` status with no ``start_tree`` when the tree cannot be snapshotted
is recorded as ``unverified`` (``requested_status: clean``), never as clean: an
entry with ``tree: null`` cannot be compared with anything, so it must not
clear a gate.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone

HOME = os.environ.get("VIBESTACK_HOME", os.path.expanduser("~/.vibestack"))

# --- secret patterns: begin (same labels and placeholder rules as bin/vibe-redact-prepush;
# lib/snippets/secret-scan-patterns.md is the canonical list, test-redact-scan.sh keeps them equal)
SECRET_PATTERNS = [
    ("AWS access key", r"AKIA[0-9A-Z]{16}"),
    ("AWS temporary key", r"ASIA[0-9A-Z]{16}"),
    ("GitHub token", r"gh(p|o|s|u|r)_[A-Za-z0-9]{36}"),
    ("GitHub fine-grained token", r"github_pat_[A-Za-z0-9_]{22,}"),
    ("Slack token", r"xox[abpr]-[A-Za-z0-9-]{10,}"),
    ("Stripe live key", r"(sk|rk)_live_[A-Za-z0-9]{20,}"),
    ("Google API key", r"AIza[0-9A-Za-z_-]{35}"),
    ("Anthropic key", r"sk-ant-[A-Za-z0-9_-]{20,}"),
    ("OpenAI key (modern)", r"sk-(proj|svcacct|admin)-[A-Za-z0-9_-]{20,}"),
    ("OpenAI key (classic)", r"sk-[A-Za-z0-9]{48}"),
    ("GitLab token", r"gl(pat|ptt|dt)-[A-Za-z0-9_-]{20,}"),
    ("HuggingFace token", r"hf_[A-Za-z0-9]{30,}"),
    ("npm token", r"npm_[A-Za-z0-9]{36}"),
    ("DigitalOcean token", r"dop_v1_[a-f0-9]{64}"),
    ("Private key block", r"-----BEGIN[^-\n]*PRIVATE KEY-----"),
    ("AWS secret key", r"aws_secret_access_key[^A-Za-z0-9\n]+[A-Za-z0-9/+=]{40}"),
    ("SecretAccessKey field", r"\"?SecretAccessKey\"?[ \t]*[:=][ \t]*\"?[A-Za-z0-9/+=]{40}"),
    ("env-style secret", r"^[ \t+-]{0,2}[ \t]*(-[ \t]+)?(export[ \t]+)?[A-Z][A-Z0-9_]*_(KEY|TOKEN|SECRET|PASSWORD)(=..+|[ \t]+=[ \t]*(\x22[^\x22\n]{2,}\x22|\x27[^\x27\n]{2,}\x27))"),
    ("DSN credentials", r"://[^\s:/@]{0,255}:[^\s@/]{1,255}@"),
]
_SECRET_RES = [(label, re.compile(pat, re.M)) for label, pat in SECRET_PATTERNS]
_BEARER = re.compile(r"Bearer[ \t]+([A-Za-z0-9._~+/=-]{20,})")


def _secret_placeholder(label, span):
    v = span
    if label == "env-style secret":
        # Judge the first shell word only, so `KEY=$1  # arg` or
        # `KEY="$1";` is the expansion it looks like.
        v = span.split("=", 1)[1].lstrip()
        if v[:1] in ('"', "'"):
            v = v[1:].split(v[0], 1)[0]
        else:
            v = re.split(r"[\s;]", v, maxsplit=1)[0]
    elif label == "SecretAccessKey field":
        v = re.split(r"[:=]", span, maxsplit=1)[1].lstrip()
    elif label == "DSN credentials":
        v = span[3:].split(":", 1)[1][:-1]
    for q in ('"', "'"):
        v = v[1:] if v.startswith(q) else v
        v = v[:-1] if v.endswith(q) else v
    if re.match(r"(your[_-]|<[^>]*>$|[*]+$|x{6,}$|changeme$|redacted|placeholder|dummy|fake)", v, re.I):
        return True
    # A bare $NAME is a reference only in one case ($API_KEY, $token); a
    # mixed-case run after the "$" ($ecretP4ss) is a value that starts with one.
    if re.fullmatch(r"\$(\{?([A-Z_][A-Z0-9_]*|[a-z_][a-z0-9_]*)\}?|[0-9@*#])", v):
        return True
    if re.match(r"[$][({]", v):
        return True
    # A short stub before "..." (sk-..., ghp_..., AKIA...) is a placeholder; a
    # long value, or a short one that mixes case or carries a digit with no
    # separator (P4ss..., hunter2...), is still a value.
    if v.endswith("..."):
        s = v[:-3]
        mixed = re.search(r"[A-Z]", s) and re.search(r"[a-z]", s)
        if len(s) <= 8 and not mixed and (re.search(r"[-_]", s) or not re.search(r"[0-9]", s)):
            return True
    if label == "DSN credentials" and ("\x24{" in v or "\x24(" in v or len(v) < 8 or re.fullmatch(
            r"pass|password|postgres|root|test|secret|admin|change-?me|p", v, re.I)
            or v == span[3:].split(":", 1)[0]):
        return True
    if "://" in v or "@" in v:
        return False
    return re.search(r"^example|example(key)?$", v, re.I) is not None


def find_secret(text):
    """Label of the first high-confidence secret in text, or None."""
    for label, rx in _SECRET_RES:
        for m in rx.finditer(text):
            if not _secret_placeholder(label, m.group(0)):
                return label
    for m in _BEARER.finditer(text):
        tok = m.group(1)
        if (re.search(r"[0-9]", tok) and re.search(r"[a-z]", tok) and re.search(r"[A-Z]", tok)
                and not _secret_placeholder("Bearer token", tok)):
            return "Bearer token"
    return None


def secret_in_payload(raw, obj):
    """Scan the raw JSON and every decoded key and string, one per line, so an
    env-style line or a quoted field inside a value is seen as written."""
    parts = [raw]

    def walk(x):
        if isinstance(x, str):
            parts.append(x)
        elif isinstance(x, dict):
            for k, v in x.items():
                parts.append(str(k))
                walk(v)
        elif isinstance(x, list):
            for v in x:
                walk(v)

    walk(obj)
    return find_secret("\n".join(parts))
# --- secret patterns: end ---


def _run(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout.strip()
    except Exception:
        return ""


def slug() -> str:
    here = os.path.dirname(os.path.abspath(__file__))
    # A one-time bucket migration must never run under the 5s timeout.
    out = _run(["env", "VIBESTACK_SLUG_NO_MIGRATE=1", os.path.join(here, "vibe-slug")])
    m = re.search(r"SLUG=([^\s]+)", out)
    return m.group(1) if m else "unknown"


def branch() -> str:
    return _run(["git", "branch", "--show-current"]) or "unknown"


def snapshot():
    """Tree object id (12 chars) of the working tree, untracked files included.

    Built in a throwaway index seeded from the real one, so the user's staged
    state is never touched. `add -A` honours .gitignore. Returns None when the
    tree cannot be fingerprinted (not a work tree, unmerged index, read-only
    object store) — an unknown tree must never be mistaken for a match.
    """
    top = _run(["git", "rev-parse", "--show-toplevel"])
    if not top:
        return None
    real = _run(["git", "-C", top, "rev-parse", "--git-path", "index"])
    if real and not os.path.isabs(real):
        real = os.path.join(top, real)
    fd, idx = tempfile.mkstemp(prefix="vibe-review-snap.")
    os.close(fd)
    env = dict(os.environ, GIT_INDEX_FILE=idx)
    try:
        if real and os.path.isfile(real):
            shutil.copyfile(real, idx)
        else:
            os.unlink(idx)
            if subprocess.run(["git", "-C", top, "read-tree", "--empty"], env=env,
                              capture_output=True, timeout=30).returncode != 0:
                return None
        if subprocess.run(["git", "-C", top, "add", "-A"], env=env,
                          capture_output=True, timeout=120).returncode != 0:
            return None
        out = subprocess.run(["git", "-C", top, "write-tree"], env=env,
                             capture_output=True, text=True, timeout=30)
        tree = out.stdout.strip()
        return tree[:12] if out.returncode == 0 and re.fullmatch(r"[0-9a-f]{40,64}", tree) else None
    except Exception:
        return None
    finally:
        try:
            os.unlink(idx)
        except OSError:
            pass


def main() -> int:
    args = sys.argv[1:]
    if args and args[0] == "--snapshot":
        tree = snapshot()
        if not tree:
            print("vibe-review-log: cannot snapshot this working tree", file=sys.stderr)
            return 2
        print(tree)
        return 0
    if not args:
        print('usage: vibe-review-log \'{"skill":"...","status":"..."}\'', file=sys.stderr)
        return 1
    try:
        body = json.loads(args[0])
    except Exception as e:
        print(f"error: first argument must be a JSON object ({e})", file=sys.stderr)
        return 1
    if not isinstance(body, dict) or not body.get("skill"):
        print('error: JSON must include a non-empty "skill" field', file=sys.stderr)
        return 1

    found = secret_in_payload(args[0], body)
    if found:
        print(f"error: review entry rejected — high-confidence secret present ({found}). "
              "Redact and rotate before logging.", file=sys.stderr)
        return 1

    now = datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")
    if not body.get("timestamp") or body["timestamp"] == "TIMESTAMP":
        body["timestamp"] = now
    if body.get("commit") in (None, "", "COMMIT"):
        body["commit"] = _run(["git", "rev-parse", "--short", "HEAD"]) or "unknown"
    body.setdefault("branch", branch())

    # The logger computes the tree itself; a caller-supplied value is not trusted.
    body["tree"] = snapshot()
    start = body.get("start_tree")
    if start in ("", "START_TREE", None):
        body.pop("start_tree", None)
        start = None
    if body.get("status") == "clean":
        why = None
        if start and not body["tree"]:
            why = ("the working tree cannot be snapshotted now, so nothing proves it is the "
                   f"tree the review started on ({start}). Log issues_found or incomplete.")
        elif start and start != body["tree"]:
            why = (f"the tree changed after the review started ({start} -> {body['tree']}); "
                   "those edits were never reviewed. Re-review them, or log issues_found.")
        elif body.get("completed") is False:
            why = ("completed is false: a dispatched reviewer did not finish, so this is "
                   "incomplete coverage, not a clean review. Log status incomplete.")
        elif body.get("converged") is False:
            why = ("converged is false: the last fix cycle's edits were never re-reviewed. "
                   "Log issues_found.")
        if why:
            print(f"error: clean status rejected — {why}", file=sys.stderr)
            return 1
        if not body["tree"]:
            body["status"] = "unverified"
            body["requested_status"] = "clean"
            print("warning: the working tree cannot be snapshotted, so this review is logged "
                  "as unverified, not clean — freshness cannot be proven.", file=sys.stderr)

    path = os.path.join(HOME, "projects", slug(), f"{branch()}-reviews.jsonl")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a", encoding="utf-8") as f:
        f.write(json.dumps(body, ensure_ascii=False) + "\n")
    print(f"logged review: {body['skill']} status={body.get('status','?')}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
