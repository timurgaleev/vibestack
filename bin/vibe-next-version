#!/usr/bin/env python3
"""vibe-next-version — queue-aware next VERSION pick for workspace-aware ship.

Looks at what VERSION slots are already claimed by open PRs that target the
same base branch, then returns the next free slot for the requested bump level
so two branches shipping in parallel don't collide on the same version.

A PR's claim is the VERSION file at its head ref, not anything in its title:
titles are free text, go stale after a rebump, and are often versionless. PRs
against a different base (release branches, stacked PRs) never collide with
this one and are not counted. Sibling worktree detection is not implemented;
`active_siblings` is always an empty list.

Usage:
  vibe-next-version --base main --bump minor --current-version 1.20.0

Output (JSON on stdout):
  {"version":"1.21.0","host":"github","base":"main",
   "claimed":[{"pr":12,"branch":"feat/x","version":"1.21.0","url":"..."}],
   "active_siblings":[],"warnings":[],"offline":false,"reason":"..."}

Degrades gracefully: if `gh`/`glab` are missing or unauthenticated, emits
`{"offline":true,...}` with a local bump so callers fall back to plain arithmetic.
Read-only — never writes VERSION or touches git state.

Version format: MAJOR.MINOR.PATCH (this repo's scheme). Bump levels: major, minor,
patch (micro is treated as patch for 3-part versions).
"""
import argparse
import base64
import json
import re
import subprocess
import sys
import urllib.parse
from concurrent.futures import ThreadPoolExecutor

SEMVER = re.compile(r"^(\d+)\.(\d+)\.(\d+)$")
VERSION_PATH = "VERSION"
FETCH_WORKERS = 8


def parse(v):
    m = SEMVER.match(v.strip())
    return tuple(int(x) for x in m.groups()) if m else None


def bump(v, level):
    major, minor, patch = v
    if level == "major":
        return (major + 1, 0, 0)
    if level == "minor":
        return (major, minor + 1, 0)
    return (major, minor, patch + 1)  # patch / micro


def fmt(t):
    return ".".join(str(x) for x in t)


def run(cmd):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
        return r.stdout if r.returncode == 0 else None
    except Exception:
        return None


def decode_version(b64):
    try:
        return base64.b64decode(b64).decode("utf-8").strip()
    except Exception:
        return None


def github_claims(base, exclude_pr, warnings):
    """(claims, ok). ok=False means gh is unusable here — try another host."""
    out = run(["gh", "pr", "list", "--state", "open", "--base", base, "--limit", "200",
               "--json", "number,headRefName,headRepositoryOwner,url"])
    if out is None:
        return [], False
    try:
        prs = json.loads(out)
    except Exception:
        warnings.append("gh pr list returned invalid JSON")
        return [], False
    # The contents API resolves a ref against OUR repo, so a fork PR's branch
    # name would read our own branch (or base) and report a phantom claim.
    owner = (run(["gh", "repo", "view", "--json", "owner", "-q", ".owner.login"]) or "").strip()
    if not owner:
        warnings.append("could not resolve the repo owner; fork PRs were not filtered out")
    prs = [p for p in prs
           if (exclude_pr is None or p.get("number") != exclude_pr)
           and (not owner or ((p.get("headRepositoryOwner") or {}).get("login") or "") == owner)]

    def fetch(pr):
        ref = urllib.parse.quote(pr.get("headRefName", ""), safe="")
        raw = run(["gh", "api", f"repos/{{owner}}/{{repo}}/contents/{VERSION_PATH}?ref={ref}",
                   "-q", ".content"])
        if raw is None:
            return pr, None, f"PR #{pr.get('number')}: could not read {VERSION_PATH} at its head"
        return pr, decode_version(raw), None

    claims = []
    with ThreadPoolExecutor(max_workers=FETCH_WORKERS) as pool:
        for pr, ver, err in pool.map(fetch, prs):
            if err:
                warnings.append(err)
                continue
            claims.append({"pr": pr.get("number"), "branch": pr.get("headRefName", ""),
                           "version": ver, "url": pr.get("url", "")})
    return claims, True


def gitlab_claims(base, exclude_pr, warnings):
    out = run(["glab", "mr", "list", "--opened", "--target-branch", base,
               "--output", "json", "--per-page", "200"])
    if out is None:
        return [], False
    try:
        mrs = json.loads(out)
    except Exception:
        warnings.append("glab mr list returned invalid JSON")
        return [], False
    claims = []
    for mr in mrs:
        if exclude_pr is not None and mr.get("iid") == exclude_pr:
            continue
        branch = mr.get("source_branch", "")
        raw = run(["glab", "api", "projects/:id/repository/files/"
                   f"{urllib.parse.quote(VERSION_PATH, safe='')}?ref={urllib.parse.quote(branch, safe='')}"])
        ver = None
        if raw is not None:
            try:
                ver = decode_version(json.loads(raw).get("content", ""))
            except Exception:
                ver = None
        if raw is None or ver is None:
            warnings.append(f"MR !{mr.get('iid')}: could not read {VERSION_PATH} at its head")
            continue
        claims.append({"pr": mr.get("iid"), "branch": branch, "version": ver,
                       "url": mr.get("web_url", "")})
    return claims, True


def open_claims(base, exclude_pr, warnings):
    """(host, claims) — host is None when no PR host is reachable."""
    claims, ok = github_claims(base, exclude_pr, warnings)
    if ok:
        return "github", claims
    claims, ok = gitlab_claims(base, exclude_pr, warnings)
    if ok:
        return "gitlab", claims
    return None, []


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--base", default="main")
    ap.add_argument("--bump", default="patch")
    ap.add_argument("--current-version", required=True)
    ap.add_argument("--exclude-pr", type=int, default=None,
                    help="PR/MR number to ignore when tallying claimed slots — "
                         "pass your own when checking whether your version is still free")
    args = ap.parse_args()

    def emit(**fields):
        out = {"host": "unknown", "base": args.base, "claimed": [],
               "active_siblings": [], "warnings": [], "offline": False}
        out.update(fields)
        print(json.dumps(out))
        return 0

    cur = parse(args.current_version)
    if not cur:
        return emit(offline=True, version=args.current_version,
                    reason="current-version not MAJOR.MINOR.PATCH")

    target = bump(cur, args.bump)
    warnings = []
    host, raw_claims = open_claims(args.base, args.exclude_pr, warnings)

    if host is None:
        return emit(offline=True, version=fmt(target), warnings=warnings,
                    reason="no PR host reachable — local bump only")

    claimed = []
    for c in raw_claims:
        p = parse(c["version"] or "")
        if p is None:
            warnings.append(f"#{c['pr']}: {VERSION_PATH} is malformed ({c['version']!r})")
            continue
        # A PR still carrying the base version (or older) has not bumped; it
        # holds no slot.
        if p <= cur:
            continue
        claimed.append(dict(c, version=fmt(p)))

    claimed_set = {parse(c["version"]) for c in claimed}
    # Step forward at the requested level until the slot is free.
    picked = target
    guard = 0
    while picked in claimed_set and guard < 1000:
        picked = bump(picked, args.bump)
        guard += 1

    if not claimed:
        reason = "no open PRs claim a slot"
    elif picked != target:
        reason = "advanced past claimed slots"
    else:
        reason = "next free slot"
    claimed.sort(key=lambda c: (parse(c["version"]), c["pr"] or 0))
    return emit(host=host, version=fmt(picked), claimed=claimed,
                warnings=warnings, reason=reason)


if __name__ == "__main__":
    sys.exit(main())
