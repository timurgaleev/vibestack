#!/usr/bin/env bash
# vibe-redact-prepush — git pre-push hook that scans the diff being pushed for
# high-confidence credentials and unresolved merge-conflict markers, and blocks
# the push on a hit.
#
# THIS IS A GUARDRAIL, NOT ENFORCEMENT. `git push --no-verify` bypasses it, as
# does `VIBESTACK_REDACT_PREPUSH=skip`. It catches accidental credential
# pushes, the most common real-world leak. It does NOT scan history, binary
# files, or unchanged lines — history scanning is /cso's job.
#
# Git pre-push interface: refs arrive on STDIN, one per line:
#   <local ref> <local sha> <remote ref> <remote sha>
# We scan the ADDED lines of <remote sha>..<local sha> per ref. Special cases:
#   - remote sha all-zeroes → new branch: diff against merge-base with the
#     remote default branch (fallback: the empty tree, which scans everything).
#   - remote tip object absent locally (shallow clone / stale force-push) →
#     same merge-base/empty-tree fallback — scans MORE, never less.
#   - local sha all-zeroes → branch delete: nothing pushed, skip.
#
# Fail-closed: if the pushed diff cannot be computed, the push is BLOCKED —
# unscanned-but-allowed is the exact failure mode this hook exists to prevent.
set -uo pipefail
[ "${BASH_VERSINFO[0]}" -lt 5 ] || BASH_COMPAT=50

VIBE_HOME="${VIBESTACK_HOME:-$HOME/.vibestack}"
EMPTY_TREE="4b825dc642cb6eb9a060e54bf8d69288fbee4904"

log_skip() {
  mkdir -p "$VIBE_HOME/security" 2>/dev/null || true
  printf '{"ts":"%s","reason":"%s"}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${VIBESTACK_REDACT_PREPUSH_REASON:-env-skip}" \
    >> "$VIBE_HOME/security/prepush-skip.jsonl" 2>/dev/null || true
}

block_no_diff() {
  {
    echo ""
    echo "BLOCKED: vibe-redact-prepush could not compute the pushed diff, so it"
    echo "cannot be scanned for credentials. ($1)"
    echo "Bypass if you're sure: VIBESTACK_REDACT_PREPUSH=skip git push   (or git push --no-verify)"
  } >&2
  exit 1
}

default_remote_branch() {
  local sym
  sym=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null || true)
  if [ -n "$sym" ]; then
    printf '%s\n' "${sym#refs/remotes/}"
    return
  fi
  local b
  for b in origin/main origin/master; do
    if git rev-parse --verify --quiet "$b" >/dev/null 2>&1; then
      printf '%s\n' "$b"
      return
    fi
  done
  printf 'origin/main\n'
}

# The zero-context diff of the range being pushed for one ref update.
pushed_diff_for() {
  local local_sha="$1" remote_sha="$2" range base
  if printf '%s' "$remote_sha" | grep -qE '^0+$' \
     || ! git cat-file -e "$remote_sha" 2>/dev/null; then
    base=$(git merge-base "$local_sha" "$(default_remote_branch)" 2>/dev/null || true)
    if [ -n "$base" ]; then range="$base..$local_sha"; else range="$EMPTY_TREE..$local_sha"; fi
  else
    range="$remote_sha..$local_sha"
  fi
  # Fixed prefixes and raw paths, whatever diff.noprefix or core.quotePath say:
  # conflict_markers_in reads the path back out of the "+++ b/" header.
  git -c core.quotePath=false diff --unified=0 --no-color --no-ext-diff --no-textconv --text \
    --src-prefix=a/ --dst-prefix=b/ "$range" 2>/dev/null
}

# Added lines of a pushed diff.
added_lines_in() {
  printf '%s\n' "$1" | grep -E '^\+' | grep -vE '^\+\+\+' | sed 's/^+//' || true
}

# Line numbers (1-based) of a markdown file that sit inside a ```text or
# ```diff fence — where a document quotes a conflict to explain one.
md_quoted_lines() {
  awk '
    {
      t = $0; ind = match(t, /[^ ]/) - 1
      if (ind < 0 || ind > 3) { if (fence && quoted) print NR; next }
      t = substr(t, ind + 1)
    }
    !fence {
      if (t ~ /^```/ || t ~ /^~~~/) {
        fc = substr(t, 1, 1); fn = 0
        while (substr(t, fn + 1, 1) == fc) fn++
        info = substr(t, fn + 1); sub(/^[ \t]+/, "", info); sub(/[ \t].*$/, "", info)
        fence = 1; quoted = (tolower(info) == "text" || tolower(info) == "diff")
      }
      next
    }
    {
      u = t; sub(/[ \t]+$/, "", u); n = length(u); gsub(fc, "", u)
      if (u == "" && n >= fn) { fence = 0; quoted = 0; next }
      if (quoted) print NR
    }
  '
}

# Prints "<path>:<line>" for each unresolved merge-conflict marker the pushed
# diff ($2, ending at commit $1) adds. Markers quoted in a text/diff fence of a
# .md file are documentation.
conflict_markers_in() {
  local local_sha="$1" diff="$2" hits path n quoted
  hits=$(printf '%s\n' "$diff" | awk '
    /^diff --git / { header = 1; next }
    header && /^\+\+\+ / { path = substr($0, 7); sub(/\t$/, "", path); next }
    /^@@ / { header = 0; split($3, a, ","); n = substr(a[1], 2) + 0; next }
    header { next }
    /^\+/ {
      line = substr($0, 2)
      if (line ~ /^(<<<<<<<|>>>>>>>)( |$)/) { print path "\t" n; marked[path] = 1 }
      else if (line ~ /^=======$/) eq[path] = eq[path] n " "
      n++
    }
    END {
      for (p in eq) {
        if (!(p in marked)) continue
        k = split(eq[p], ns, " ")
        for (i = 1; i <= k; i++) print p "\t" ns[i]
      }
    }
  ')
  [ -n "$hits" ] || return 0
  while IFS=$'\t' read -r path n; do
    case "$path" in
      *.md|*.MD|*.markdown)
        quoted=$(git show "$local_sha:$path" 2>/dev/null | md_quoted_lines)
        printf '%s\n' "$quoted" | grep -qxF -- "$n" && continue ;;
    esac
    printf '%s:%s\n' "$path" "$n"
  done <<< "$hits"
}

# High-confidence credential patterns (kept in sync with
# lib/snippets/secret-scan-patterns.md). Format: "<label>|<POSIX ERE>".
# `vibe-redact scan` sources this file for the same list and matcher.
PATTERNS=(
  'AWS access key|AKIA[0-9A-Z]{16}'
  'AWS temporary key|ASIA[0-9A-Z]{16}'
  'GitHub token|gh(p|o|s|u|r)_[A-Za-z0-9]{36}'
  'GitHub fine-grained token|github_pat_[A-Za-z0-9_]{22,}'
  'Slack token|xox[abpr]-[A-Za-z0-9-]{10,}'
  'Stripe live key|(sk|rk)_live_[A-Za-z0-9]{20,}'
  'Google API key|AIza[0-9A-Za-z_-]{35}'
  'Anthropic key|sk-ant-[A-Za-z0-9_-]{20,}'
  'OpenAI key (modern)|sk-(proj|svcacct|admin)-[A-Za-z0-9_-]{20,}'
  'OpenAI key (classic)|sk-[A-Za-z0-9]{48}'
  'GitLab token|gl(pat|ptt|dt)-[A-Za-z0-9_-]{20,}'
  'HuggingFace token|hf_[A-Za-z0-9]{30,}'
  'npm token|npm_[A-Za-z0-9]{36}'
  'DigitalOcean token|dop_v1_[a-f0-9]{64}'
  'Private key block|-----BEGIN[^-]*PRIVATE KEY-----'
  'AWS secret key|aws_secret_access_key[^A-Za-z0-9]+[A-Za-z0-9/+=]{40}'
  'SecretAccessKey field|"?SecretAccessKey"?[[:space:]]*[:=][[:space:]]*"?[A-Za-z0-9/+=]{40}'
  'env-style secret|^[[:space:]+-]{0,2}[[:space:]]*(-[[:space:]]+)?(export[[:space:]]+)?[A-Z][A-Z0-9_]*_(KEY|TOKEN|SECRET|PASSWORD)(=..+|[[:space:]]+=[[:space:]]*("[^"]{2,}"|'\''[^'\'']{2,}'\''))'
  'DSN credentials|://[^[:space:]:/@]{0,255}:[^[:space:]@/]{1,255}@'
)

# A matched span that is itself a documentation placeholder is not a finding:
# the AWS docs keys (AKIAIOSFODNN7EXAMPLE), <your-token>, xxxxxx, ****,
# your_api_key, ${DB_PASSWORD}, $(gh auth token), sk-... Judged on the span
# alone, never on the rest of the line, so a live key sitting next to the word
# "example" still blocks. For name=value shapes only the value is judged —
# EXAMPLE_API_KEY=<live value> is a finding — and for a URL only its password,
# where local dev and test strings (postgres:postgres, user:pass, a password
# that repeats the user name) are the norm.
redact_is_placeholder() {
  local label="$1" span="$2" v u s
  v="$span"
  case "$label" in
    "env-style secret")
      # Judge the first shell word only, so `KEY=$1  # arg` or `KEY="$1";`
      # is the expansion it looks like.
      v="${span#*=}"; v="${v#"${v%%[![:space:]]*}"}"
      case "$v" in
        \"*) v="${v#\"}"; v="${v%%\"*}" ;;
        \'*) v="${v#\'}"; v="${v%%\'*}" ;;
        *) v="${v%%[[:space:];]*}" ;;
      esac ;;
    "SecretAccessKey field") v="${span#*[:=]}"; v="${v#"${v%%[![:space:]]*}"}" ;;
    "DSN credentials") v="${span#://}"; v="${v#*:}"; v="${v%@}" ;;
  esac
  v="${v#\"}"; v="${v%\"}"; v="${v#\'}"; v="${v%\'}"
  printf '%s' "$v" | grep -qiE '^(your[_-]|<[^>]*>$|[*]+$|x{6,}$|changeme$|redacted|placeholder|dummy|fake)' && return 0
  # A bare $NAME is a reference only in one case ($API_KEY, $token); a
  # mixed-case run after the "$" ($ecretP4ss) is a value that starts with one.
  printf '%s' "$v" | grep -qE '^[$]([{]?([[:upper:]_][[:upper:][:digit:]_]*|[[:lower:]_][[:lower:][:digit:]_]*)[}]?|[0-9@*#])$' && return 0
  case "$v" in '$('*|'${'*) return 0 ;; esac
  # A short stub before "..." (sk-..., ghp_..., AKIA...) is a placeholder; a
  # long value, or a short one that mixes case or carries a digit with no
  # separator (P4ss..., hunter2...), is still a value.
  case "$v" in *...)
    s="${v%...}"
    u=""
    case "$s" in *[[:upper:]]*) case "$s" in *[[:lower:]]*) u=mixed ;; esac ;; esac
    if [ "${#s}" -le 8 ] && [ -z "$u" ]; then
      case "$s" in *[-_]*) return 0 ;; *[0-9]*) ;; *) return 0 ;; esac
    fi ;;
  esac
  if [ "$label" = "DSN credentials" ]; then
    # ${USER:-x}:${PASS}@ splits at the default's colon, so judge the whole
    # span for an expansion; a bare "$" inside a generated password is not one.
    case "$v" in *'${'*|*'$('*) return 0 ;; esac
    [ "${#v}" -lt 8 ] && return 0
    u="${span#://}"; [ "$v" = "${u%%:*}" ] && return 0
    printf '%s' "$v" | grep -qiE '^(pass|password|postgres|root|test|secret|admin|change-?me|p)$' && return 0
  fi
  case "$v" in *://*|*@*) return 1 ;; esac
  # Only a value that starts or ends with "example" (AKIA...EXAMPLE,
  # ...EXAMPLEKEY, example-token) — a word in the middle (MyExampleCorp2024!)
  # is part of a real secret as often as not.
  printf '%s' "$v" | grep -qiE '^example|example(key)?$' && return 0
  return 1
}

# The shared matcher. Prints one finding per line as
#   <line number><TAB><label><TAB><matched span>
# for the text in $1 (line numbers are 1-based within that text). Returns 0
# when it ran, 2 when grep itself failed — a scan that did not run is never
# treated as clean.
redact_find() {
  local text="$1" entry label pat out rc line n span tok
  for entry in "${PATTERNS[@]}"; do
    label="${entry%%|*}"
    pat="${entry#*|}"
    rc=0
    out=$(printf '%s\n' "$text" | grep -noE -e "$pat" 2>/dev/null) || rc=$?
    [ "$rc" -gt 1 ] && return 2
    [ -n "$out" ] || continue
    while IFS= read -r line; do
      n="${line%%:*}"; span="${line#*:}"
      redact_is_placeholder "$label" "$span" && continue
      printf '%s\t%s\t%s\n' "$n" "$label" "$span"
    done <<< "$out"
  done
  # Bearer tokens, entropy-gated: >=20 chars with a digit, a lowercase, and an
  # uppercase — placeholders (YOUR_TOKEN_HERE, <token>, xxxx...) don't qualify.
  rc=0
  out=$(printf '%s\n' "$text" | grep -noE -e 'Bearer[ 	]+[A-Za-z0-9._~+/=-]{20,}' 2>/dev/null) || rc=$?
  [ "$rc" -gt 1 ] && return 2
  if [ -n "$out" ]; then
    while IFS= read -r line; do
      n="${line%%:*}"
      tok=$(printf '%s' "${line#*:}" | sed -E 's/^Bearer[ 	]+//')
      case "$tok" in *[0-9]*) ;; *) continue ;; esac
      case "$tok" in *[a-z]*) ;; *) continue ;; esac
      case "$tok" in *[A-Z]*) ;; *) continue ;; esac
      redact_is_placeholder "Bearer token" "$tok" && continue
      printf '%s\t%s\t%s\n' "$n" "Bearer token" "$tok"
    done <<< "$out"
  fi
  return 0
}

# Print masked findings for one blob of text; returns 0 if any finding, 1 if
# none, 2 if the matcher could not run.
scan_added() {
  local text="$1" hits rc=0 n label span
  hits=$(redact_find "$text") || rc=$?
  [ "$rc" -eq 0 ] || return 2
  [ -n "$hits" ] || return 1
  while IFS=$'\t' read -r n label span; do
    printf '  HIGH  %-22s %.10s...\n' "$label" "$span"
  done <<< "$hits"
  return 0
}

prepush_main() {
  case "$(printf '%s' "${VIBESTACK_REDACT_PREPUSH:-}" | tr '[:upper:]' '[:lower:]')" in
    skip)
      log_skip
      echo "vibe-redact-prepush: skipped via VIBESTACK_REDACT_PREPUSH=skip" >&2
      # Read the ref list git hands over; leaving it unread can fail the
      # caller's pipe with SIGPIPE and turn the bypass into a blocked push.
      [ -t 0 ] || cat >/dev/null
      exit 0 ;;
  esac

  findings=""
  conflicts=""
  # `|| [ -n ... ]` keeps the last line when stdin lacks a trailing newline
  # (the managed wrapper pipes refs via printf '%s').
  while read -r _local_ref local_sha _remote_ref remote_sha _rest || [ -n "${local_sha:-}" ]; do
    [ -n "${local_sha:-}" ] || continue
    printf '%s' "$local_sha" | grep -qE '^0+$' && continue   # branch delete
    if ! diff=$(pushed_diff_for "$local_sha" "${remote_sha:-0}"); then
      block_no_diff "git diff failed for $local_sha"
    fi
    added=$(added_lines_in "$diff")
    [ -n "$(printf '%s' "$added" | tr -d '[:space:]')" ] || continue
    rc=0
    hit=$(scan_added "$added") || rc=$?
    case "$rc" in
      0) findings="$findings$hit"$'\n' ;;
      1) ;;
      *) block_no_diff "credential matcher failed for $local_sha" ;;
    esac
    hit=$(conflict_markers_in "$local_sha" "$diff")
    [ -z "$hit" ] || conflicts="$conflicts$hit"$'\n'
  done

  if [ -n "$conflicts" ]; then
    {
      echo ""
      echo "BLOCKED: vibe-redact-prepush found unresolved merge-conflict marker(s) in the pushed diff:"
      echo ""
      printf '%s' "$conflicts" | sed 's/^/  /'
      echo ""
      echo "Resolve the conflict and commit the result before pushing."
      echo "This is a guardrail: 'git push --no-verify' or 'VIBESTACK_REDACT_PREPUSH=skip git push' bypass it."
    } >&2
  fi

  if [ -n "$findings" ]; then
    {
      echo ""
      echo "BLOCKED: vibe-redact-prepush found credential(s) in the pushed diff:"
      echo ""
      printf '%s' "$findings"
      echo ""
      echo "Rotate the credential (a pushed secret is compromised) and remove it from the diff."
      echo "This is a guardrail: 'git push --no-verify' or 'VIBESTACK_REDACT_PREPUSH=skip git push' bypass it."
    } >&2
    exit 1
  fi
  [ -z "$conflicts" ] || exit 1

  exit 0
}

# Sourced by `vibe-redact scan` for the patterns and matcher; run as the hook otherwise.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  prepush_main "$@"
fi
