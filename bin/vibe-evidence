#!/usr/bin/env python3
"""vibe-evidence — record what a command actually did, so a later gate can check
it instead of trusting prose.

A skill that says "tests pass" has told you nothing checkable: the claim and a
fabricated claim are the same bytes. This records the three facts that make it
checkable — the command, its exit status, and the content fingerprint of the
tree it ran against — so a gate can ask "did THIS tree pass?" and get an answer
from the ledger rather than from the summary.

Usage:
  vibe-evidence run --skill ship --label tests -- pytest -q
  vibe-evidence run --skill ship --label tests -- 'npm ci && npm test'
  vibe-evidence read [--skill S] [--label L] [--tree H] [--limit N]
  vibe-evidence check (--label L | --expect-cmd C | both) [--skill S] [--tree H]
                      [--max-age HOURS] [--allow-paths a,b,dir/]

`run` streams the command's output through untouched and exits with the
command's own status, so it drops into a pipeline without changing behavior.
Several arguments after `--` are executed as an argv. A single argument is a
shell command line and runs through bash (or sh when bash is absent), so a
skill can record the exact string it documents — `&&`, pipes and `cd` included
— and later ask for that same string with `--expect-cmd`.

`check` exits 0 when the most recent matching record PASSED (exit 0) at the
given tree hash (default: the tree right now), 1 when it did not, so a gate can
be a plain `if`. A missing ledger is a failed check, never a passing one —
absent evidence is not evidence. Filters narrow what "matching" means:
  --expect-cmd C   the recorded command line must equal C byte for byte; a run
                   of a different command is not evidence for this one
  --max-age H      a pass older than H hours is STALE
  --allow-paths P  a record taken at another tree still counts when the only
                   paths that differ between that tree and this one are in P
                   (exact paths, or directory prefixes ending in `/`). Meant
                   for release bookkeeping — CHANGELOG.md, VERSION — never for
                   anything a test could read.

Only the command line, its exit status and the tree hash are stored. Command
OUTPUT is deliberately not recorded: it is unbounded, and it is the most likely
place for a token or a customer identifier to appear. A command line carrying a
high-confidence secret is rejected outright (exit 2, nothing written).
"""
import json
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime, timezone

HOME = os.environ.get("VIBESTACK_HOME", os.path.expanduser("~/.vibestack"))
HERE = os.path.dirname(os.path.abspath(__file__))

# --- secret patterns: begin (same labels and placeholder rules as bin/vibe-redact-prepush;
# lib/snippets/secret-scan-patterns.md is the canonical list, test-redact-scan.sh keeps them equal)
SECRET_PATTERNS = [
    ("AWS access key", r"AKIA[0-9A-Z]{16}"),
    ("AWS temporary key", r"ASIA[0-9A-Z]{16}"),
    ("GitHub token", r"gh(p|o|s|u|r)_[A-Za-z0-9]{36}"),
    ("GitHub fine-grained token", r"github_pat_[A-Za-z0-9_]{22,}"),
    ("Slack token", r"xox[abpr]-[A-Za-z0-9-]{10,}"),
    ("Stripe live key", r"(sk|rk)_live_[A-Za-z0-9]{20,}"),
    ("Google API key", r"AIza[0-9A-Za-z_-]{35}"),
    ("Anthropic key", r"sk-ant-[A-Za-z0-9_-]{20,}"),
    ("OpenAI key (modern)", r"sk-(proj|svcacct|admin)-[A-Za-z0-9_-]{20,}"),
    ("OpenAI key (classic)", r"sk-[A-Za-z0-9]{48}"),
    ("GitLab token", r"gl(pat|ptt|dt)-[A-Za-z0-9_-]{20,}"),
    ("HuggingFace token", r"hf_[A-Za-z0-9]{30,}"),
    ("npm token", r"npm_[A-Za-z0-9]{36}"),
    ("DigitalOcean token", r"dop_v1_[a-f0-9]{64}"),
    ("Private key block", r"-----BEGIN[^-\n]*PRIVATE KEY-----"),
    ("AWS secret key", r"aws_secret_access_key[^A-Za-z0-9\n]+[A-Za-z0-9/+=]{40}"),
    ("SecretAccessKey field", r"\"?SecretAccessKey\"?[ \t]*[:=][ \t]*\"?[A-Za-z0-9/+=]{40}"),
    ("env-style secret", r"^[ \t+-]{0,2}[ \t]*(-[ \t]+)?(export[ \t]+)?[A-Z][A-Z0-9_]*_(KEY|TOKEN|SECRET|PASSWORD)(=..+|[ \t]+=[ \t]*(\x22[^\x22\n]{2,}\x22|\x27[^\x27\n]{2,}\x27))"),
    ("DSN credentials", r"://[^\s:/@]{0,255}:[^\s@/]{1,255}@"),
]
_SECRET_RES = [(label, re.compile(pat, re.M)) for label, pat in SECRET_PATTERNS]
_BEARER = re.compile(r"Bearer[ \t]+([A-Za-z0-9._~+/=-]{20,})")


def _secret_placeholder(label, span):
    v = span
    if label == "env-style secret":
        # Judge the first shell word only, so `KEY=$1  # arg` or
        # `KEY="$1";` is the expansion it looks like.
        v = span.split("=", 1)[1].lstrip()
        if v[:1] in ('"', "'"):
            v = v[1:].split(v[0], 1)[0]
        else:
            v = re.split(r"[\s;]", v, maxsplit=1)[0]
    elif label == "SecretAccessKey field":
        v = re.split(r"[:=]", span, maxsplit=1)[1].lstrip()
    elif label == "DSN credentials":
        v = span[3:].split(":", 1)[1][:-1]
    for q in ('"', "'"):
        v = v[1:] if v.startswith(q) else v
        v = v[:-1] if v.endswith(q) else v
    if re.match(r"(your[_-]|<[^>]*>$|[*]+$|x{6,}$|changeme$|redacted|placeholder|dummy|fake)", v, re.I):
        return True
    # A bare $NAME is a reference only in one case ($API_KEY, $token); a
    # mixed-case run after the "$" ($ecretP4ss) is a value that starts with one.
    if re.fullmatch(r"\$(\{?([A-Z_][A-Z0-9_]*|[a-z_][a-z0-9_]*)\}?|[0-9@*#])", v):
        return True
    if re.match(r"[$][({]", v):
        return True
    # A short stub before "..." (sk-..., ghp_..., AKIA...) is a placeholder; a
    # long value, or a short one that mixes case or carries a digit with no
    # separator (P4ss..., hunter2...), is still a value.
    if v.endswith("..."):
        s = v[:-3]
        mixed = re.search(r"[A-Z]", s) and re.search(r"[a-z]", s)
        if len(s) <= 8 and not mixed and (re.search(r"[-_]", s) or not re.search(r"[0-9]", s)):
            return True
    if label == "DSN credentials" and ("\x24{" in v or "\x24(" in v or len(v) < 8 or re.fullmatch(
            r"pass|password|postgres|root|test|secret|admin|change-?me|p", v, re.I)
            or v == span[3:].split(":", 1)[0]):
        return True
    if "://" in v or "@" in v:
        return False
    return re.search(r"^example|example(key)?$", v, re.I) is not None


def find_secret(text):
    """Label of the first high-confidence secret in text, or None."""
    for label, rx in _SECRET_RES:
        for m in rx.finditer(text):
            if not _secret_placeholder(label, m.group(0)):
                return label
    for m in _BEARER.finditer(text):
        tok = m.group(1)
        if (re.search(r"[0-9]", tok) and re.search(r"[a-z]", tok) and re.search(r"[A-Z]", tok)
                and not _secret_placeholder("Bearer token", tok)):
            return "Bearer token"
    return None


def secret_in_payload(raw, obj):
    """Scan the raw JSON and every decoded key and string, one per line, so an
    env-style line or a quoted field inside a value is seen as written."""
    parts = [raw]

    def walk(x):
        if isinstance(x, str):
            parts.append(x)
        elif isinstance(x, dict):
            for k, v in x.items():
                parts.append(str(k))
                walk(v)
        elif isinstance(x, list):
            for v in x:
                walk(v)

    walk(obj)
    return find_secret("\n".join(parts))
# --- secret patterns: end ---


def _run(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout.strip()
    except Exception:
        return ""


def slug():
    # A one-time bucket migration must never run under the 5s timeout.
    m = re.search(r"SLUG=([^\s]+)", _run(["env", "VIBESTACK_SLUG_NO_MIGRATE=1", os.path.join(HERE, "vibe-slug")]))
    return m.group(1) if m else "unknown"


def tree_hash():
    """Current content fingerprint (full tree id), or "" when it cannot be computed.

    "" is never treated as a match by `check` — an unknown tree must not
    silently satisfy a gate that asked about a specific one.
    """
    return _run([os.path.join(HERE, "vibe-tree-hash"), "--long"])


def resolve_tree(ref):
    """Full tree id for a recorded or caller-given hash, or "" when the object
    store no longer has it (gc'd, another clone). Unknown never matches."""
    if not ref or not re.fullmatch(r"[0-9a-f]{7,64}", ref):
        return ""
    out = _run(["git", "rev-parse", "--verify", "-q", ref + "^{tree}"])
    return out if re.fullmatch(r"[0-9a-f]{40,64}", out) else ""


def changed_paths(old, new):
    """Paths that differ between two tree ids, or None when git cannot say."""
    try:
        proc = subprocess.run(["git", "diff-tree", "-r", "--name-only", "--no-renames", old, new],
                              capture_output=True, text=True, timeout=30)
    except Exception:
        return None
    if proc.returncode != 0:
        return None
    return [l for l in proc.stdout.splitlines() if l]


def allowed(path, allow):
    return any(path == a or (a.endswith("/") and path.startswith(a)) for a in allow)


def parse_ts(ts):
    try:
        return datetime.strptime(ts, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    except (TypeError, ValueError):
        return None


def repo_id():
    """Absolute path of the repo root, or "" outside one.

    The slug alone is not an identity: two checkouts of different projects can
    produce the same slug, and their ledgers then live in the same file. Two
    unrelated repos with an identical tree would satisfy each other's gates.
    """
    top = _run(["git", "rev-parse", "--show-toplevel"])
    return os.path.realpath(top) if top else ""


def ledger():
    d = os.path.join(HOME, "projects", slug())
    os.makedirs(d, exist_ok=True)
    return os.path.join(d, "evidence.jsonl")


def read_all():
    """Return (rows, corrupt). `corrupt` counts lines that would not parse.

    A torn line is skipped rather than fatal, but the COUNT is returned and
    `check` fails on it. Silently dropping an unreadable record lets a stale
    pass outlive the failure that was supposed to supersede it -- corruption
    would fail open, which is the one direction a gate may never fail.
    """
    p = ledger()
    if not os.path.exists(p):
        return [], 0
    out = []
    corrupt = 0
    with open(p) as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                out.append(json.loads(line))
            except ValueError:
                corrupt += 1
    return out, corrupt


def cmd_run(argv):
    skill = label = None
    rest = None
    i = 0
    while i < len(argv):
        if argv[i] == "--skill" and i + 1 < len(argv):
            skill = argv[i + 1]; i += 2
        elif argv[i] == "--label" and i + 1 < len(argv):
            label = argv[i + 1]; i += 2
        elif argv[i] == "--":
            rest = argv[i + 1:]; break
        else:
            print("vibe-evidence: unexpected argument: %s" % argv[i], file=sys.stderr)
            return 2
    if not rest:
        print("vibe-evidence run: nothing after --", file=sys.stderr)
        return 2

    command = " ".join(rest)
    meta = {
        "skill": skill or "unknown",
        "label": label or (rest[0] if rest else "unknown"),
        "command": command,
    }
    # Every field that reaches the ledger is scanned, and each argument on its
    # own line as well: an env-style KEY=value argument is judged at a line
    # start, the way the other sinks see it.
    if find_secret("\n".join(rest)) or secret_in_payload(json.dumps(meta), meta):
        print("vibe-evidence: the entry carries a high-confidence secret; refusing to record", file=sys.stderr)
        return 2
    # One argument is a command line, recorded verbatim so `--expect-cmd` can
    # ask for exactly the string a skill documents.
    argv = [shutil.which("bash") or "/bin/sh", "-c", rest[0]] if len(rest) == 1 else rest

    # The tree is fingerprinted BEFORE the command runs. A command that writes
    # to the tree (a formatter, a codegen step) would otherwise be recorded
    # against the tree it produced rather than the one it was checking.
    full = tree_hash()
    try:
        proc = subprocess.run(argv)
        code = proc.returncode
    except OSError as e:
        print("vibe-evidence: cannot start %s: %s" % (argv[0], e), file=sys.stderr)
        code = 127

    entry = {
        "ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        **meta,
        "exit": code,
        "tree": full[:12],
        "tree_full": full,
        "repo": repo_id(),
        "branch": _run(["git", "branch", "--show-current"]) or "unknown",
    }
    with open(ledger(), "a") as fh:
        fh.write(json.dumps(entry, separators=(",", ":")) + "\n")
    return code


def cmd_read(argv):
    f = {"skill": None, "label": None, "tree": None}
    limit = 20
    i = 0
    while i < len(argv):
        if argv[i] in ("--skill", "--label", "--tree") and i + 1 < len(argv):
            f[argv[i][2:]] = argv[i + 1]; i += 2
        elif argv[i] == "--limit" and i + 1 < len(argv):
            limit = int(argv[i + 1]); i += 2
        else:
            print("vibe-evidence: unexpected argument: %s" % argv[i], file=sys.stderr)
            return 2
    rows, _ = read_all()
    rows = [r for r in rows
            if all(f[k] is None or r.get(k) == f[k] for k in f)]
    for r in rows[-limit:]:
        print("%s  %-10s %-12s exit=%-3s tree=%s  %s"
              % (r.get("ts", "?"), r.get("skill", "?"), r.get("label", "?"),
                 r.get("exit", "?"), r.get("tree", "?"), r.get("command", "")))
    if not rows:
        print("no evidence recorded")
    return 0


def cmd_check(argv):
    skill = label = tree = expect = None
    max_age = None
    allow = []
    i = 0
    while i < len(argv):
        if argv[i] == "--skill" and i + 1 < len(argv):
            skill = argv[i + 1]; i += 2
        elif argv[i] == "--label" and i + 1 < len(argv):
            label = argv[i + 1]; i += 2
        elif argv[i] == "--tree" and i + 1 < len(argv):
            tree = argv[i + 1]; i += 2
        elif argv[i] == "--expect-cmd" and i + 1 < len(argv):
            expect = argv[i + 1]; i += 2
        elif argv[i] == "--max-age" and i + 1 < len(argv):
            try:
                max_age = float(argv[i + 1])
            except ValueError:
                print("vibe-evidence check: --max-age takes a number of hours", file=sys.stderr)
                return 2
            i += 2
        elif argv[i] == "--allow-paths" and i + 1 < len(argv):
            allow = [p.strip() for p in argv[i + 1].split(",") if p.strip()]; i += 2
        else:
            print("vibe-evidence: unexpected argument: %s" % argv[i], file=sys.stderr)
            return 2
    if not label and expect is None:
        print("vibe-evidence check: --label or --expect-cmd is required", file=sys.stderr)
        return 2
    what = label or "the command"
    want_full = resolve_tree(tree) if tree else tree_hash()
    want = (want_full or tree or "")[:12]
    if not want:
        # No fingerprint means the question "did THIS tree pass?" has no
        # subject. Fail rather than match everything.
        print("STALE — cannot fingerprint the tree")
        return 1

    rows, corrupt = read_all()
    if corrupt:
        print("STALE — %d unreadable record(s) in the ledger; refusing to "
              "answer from what is left" % corrupt)
        return 1

    here = repo_id()
    # A record with no repo predates the field; it matches only when this repo
    # cannot be identified either, so an old ledger does not silently satisfy a
    # different project.
    rows = [r for r in rows
            if (label is None or r.get("label") == label)
            and (expect is None or r.get("command") == expect)
            and (skill is None or r.get("skill") == skill)
            and r.get("repo", "") == here]

    def fits(r):
        """None when the record's tree is unusable, else the paths it differs by."""
        got = r.get("tree") or ""
        if got and got[:12] == want:
            return []
        if not allow or not want_full:
            return None
        old = resolve_tree(r.get("tree_full") or got)
        if not old:
            return None
        diff = changed_paths(old, want_full)
        if diff is None or not all(allowed(p, allow) for p in diff):
            return None
        return diff

    matches = [(r, d) for r in rows for d in [fits(r)] if d is not None]
    if not matches:
        print("STALE — no %s recorded at tree %s%s"
              % (what, want, " with that exact command" if expect is not None else ""))
        return 1

    # The LAST matching record decides. Taking any historical pass meant a run
    # that passed, then failed at the same tree, still reported FRESH -- the
    # newer truth lost to the older one.
    last, diff = matches[-1]
    ts = last.get("ts", "?")
    if last.get("exit") != 0:
        print("STALE — the most recent %s at tree %s exited %s (%s)"
              % (what, want, last.get("exit"), ts))
        return 1
    if max_age is not None:
        when = parse_ts(ts)
        age = (datetime.now(timezone.utc) - when).total_seconds() / 3600 if when else None
        if age is None or age > max_age:
            print("STALE — the %s pass at tree %s is older than %gh (%s)" % (what, want, max_age, ts))
            return 1
    note = " (differs only in %s)" % ", ".join(diff) if diff else ""
    print("FRESH — %s passed at tree %s%s (%s): %s"
          % (what, want, note, ts, last.get("command", "")))
    return 0


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if argv else 1
    sub, rest = argv[0], argv[1:]
    if sub == "run":
        return cmd_run(rest)
    if sub == "read":
        return cmd_read(rest)
    if sub == "check":
        return cmd_check(rest)
    print("vibe-evidence: unknown subcommand: %s" % sub, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
