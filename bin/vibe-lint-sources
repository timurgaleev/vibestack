#!/usr/bin/env bash
# vibe-lint-sources — static checks over skill sources and shared snippets.
#
# Rules:
#   fences    — every fenced code block in skills/*/SKILL.md and
#               lib/snippets/*.md is closed (an unbalanced fence silently
#               swallows include directives in the renderer). Fences follow
#               CommonMark, as the renderer does: a fence opens on 0-3 spaces
#               then 3+ backticks or 3+ tildes (an info string may follow, and
#               after backticks it may not contain a backtick) and
#               closes only on 0-3 spaces, the same character, a run at least
#               as long, and nothing but whitespace after.
#   snippets  — lib/snippets/*.md: no duplicate headings inside one snippet,
#               no nested {{include}} directives, max 400 lines.
#   hostvars  — warning only: inside bash/sh fences, $ARGUMENTS, and a
#               ${CLAUDE_SKILL_DIR} whose block has neither a :- default nor a
#               command -v fallback. Only Claude Code substitutes them; other
#               hosts see empty or literal text. Prose mentions never warn.
#   hostpath  — warning by default, a finding under --strict: a file reached
#               through ~/.claude/skills/<name>/..., a Read of a repo-relative
#               `.claude/skills/` path, or a bare qa/templates, qa/references
#               or review/TODOS-format.md path. Each resolves only where
#               Claude Code installed the pack at that one path. Use
#               ${CLAUDE_SKILL_DIR:-$HOME/.claude/skills/<name>}/... or
#               .../../<sibling>/... instead.
#
# Usage: vibe-lint-sources [--strict] [repo-root]
#        (default root: the repo containing this script)
# Exit: 0 clean, 1 findings (one file:line message per finding), 2 usage or
# a root with no skills/ directory. Warnings (warn: file:line: ...) never
# change the exit code. Under --strict a run that read nothing — no skill or
# snippet files, an unreadable file, or an awk failure in the hostpath pass —
# is a finding, never "clean".
set -uo pipefail

usage() { echo "usage: vibe-lint-sources [--strict] [repo-root]" >&2; exit 2; }
STRICT=0
ROOT=""
for arg in "$@"; do
  case "$arg" in
    --strict) STRICT=1 ;;
    -*) usage ;;
    *) [ -z "$ROOT" ] || usage; ROOT="$arg" ;;
  esac
done
ROOT="${ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
# A mistyped flag or path ("strict", "/nonexistent") lands here as the root;
# linting an empty glob would otherwise report "clean".
[ -d "$ROOT/skills" ] || { echo "vibe-lint-sources: no skills/ directory under $ROOT" >&2; exit 2; }
errors=0
say() { echo "$1"; errors=$((errors + 1)); }

# fence_step(line) returns 1 for a fence line or a line inside a fence, 0 for a
# line outside every fence. State: fc/fl (open fence char and run length, fc
# empty outside a fence), fline/fopen (line number and text of the opener).
FENCE_AWK='
function fence_step(line,   rest, c, n) {
  match(line, /^ */)
  if (RLENGTH > 3) return fc != ""
  rest = substr(line, RLENGTH + 1)
  c = substr(rest, 1, 1)
  if (c != "`" && c != "~") return fc != ""
  n = 0
  while (substr(rest, n + 1, 1) == c) n++
  if (n < 3) return fc != ""
  if (fc == "") {
    if (c == "`" && index(substr(rest, n + 1), "`")) return 0
    fc = c; fl = n; fline = NR; fopen = line; return 1
  }
  if (c == fc && n >= fl && substr(rest, n + 1) ~ /^[ \t]*$/) fc = ""
  return 1
}'

# --- fence balance ---------------------------------------------------------
while IFS= read -r f; do
  open=$(awk "$FENCE_AWK"'
    { fence_step($0) }
    END { if (fc != "") print fline ": " fopen }' "$f")
  if [ -n "$open" ]; then
    say "$f:${open%%:*}: unclosed fence opened here (${open#*: }) — an unbalanced fence swallows directives"
  fi
done < <(ls "$ROOT"/skills/*/SKILL.md "$ROOT"/lib/snippets/*.md 2>/dev/null)

# --- snippet rules ---------------------------------------------------------
for f in "$ROOT"/lib/snippets/*.md; do
  [ -f "$f" ] || continue

  lines=$(wc -l < "$f" | tr -d ' ')
  if [ "$lines" -gt 400 ]; then
    say "$f: $lines lines (max 400) — split the snippet"
  fi

  # Nested includes: the renderer supports one level only. Match the exact
  # directive grammar; indented/fenced occurrences are content, not directives
  # (fence-aware, same as the renderer's treatment).
  n=$(awk "$FENCE_AWK"'
    fence_step($0) { next }
    /^\{\{include lib\/snippets\/[A-Za-z0-9_-]+\.md\}\}$/ { print NR; exit }' "$f")
  if [ -n "$n" ]; then
    say "$f:$n: nested {{include}} — snippets must not include other snippets"
  fi

  # Duplicate headings inside one snippet (fence-aware: skip fenced blocks).
  dup=$(awk "$FENCE_AWK"'
    fence_step($0) { next }
    /^#{1,6} / {
      if (seen[$0]++) { print NR ": " $0; exit }
    }' "$f")
  if [ -n "$dup" ]; then
    say "$f:${dup%%:*}: duplicate heading (${dup#*: }) inside one snippet"
  fi
done

# --- host-only variables (warnings) ----------------------------------------
HOSTDOC="see docs/agent-skills-compatibility-audit.md"
while IFS= read -r f; do
  awk -v file="$f" -v doc="$HOSTDOC" "$FENCE_AWK"'
    function flush(   i) {
      for (i = 1; i <= nb; i++) {
        if (index(bl[i], "$ARGUMENTS"))
          printf "warn: %s:%d: $ARGUMENTS is substituted only by Claude Code — empty on other hosts; %s\n", file, bn[i], doc
        if (!guarded && (index(bl[i], "${CLAUDE_SKILL_DIR}") || bl[i] ~ /[$]CLAUDE_SKILL_DIR([^A-Za-z0-9_]|$)/))
          printf "warn: %s:%d: ${CLAUDE_SKILL_DIR} is substituted only by Claude Code — empty on other hosts; %s\n", file, bn[i], doc
      }
      nb = 0; guarded = 0
    }
    {
      was = fc; fence_step($0)
      if (was == "" && fc != "") {
        info = fopen; sub(/^ *[`~]+[ \t]*/, "", info); sub(/[ \t{].*$/, "", info)
        shell = (info == "bash" || info == "sh"); nb = 0; guarded = 0
        next
      }
      if (was != "" && fc == "") { if (shell) flush(); shell = 0; next }
      if (fc != "" && shell) {
        bl[++nb] = $0; bn[nb] = NR
        if (index($0, "CLAUDE_SKILL_DIR:-") || index($0, "command -v")) guarded = 1
      }
    }'  "$f"
done < <(ls "$ROOT"/skills/*/SKILL.md "$ROOT"/lib/snippets/*.md 2>/dev/null)

# --- hard-coded host paths ------------------------------------------------
# Every line counts, fenced or not: a prose "Read `~/.claude/skills/...`" sends
# the model to the same missing file a fenced cat does. Directory mentions with
# no file under them (`~/.claude/skills/`) describe install locations and pass.
# A file this pass could not read is reported the same way a host path is, so
# --strict fails closed instead of passing a tree it never looked at.
HP_FILES=()
for f in "$ROOT"/skills/*/SKILL.md "$ROOT"/lib/snippets/*.md; do
  [ -e "$f" ] && HP_FILES+=("$f")
done
if [ "${#HP_FILES[@]}" -eq 0 ]; then
  if [ "$STRICT" -eq 1 ]; then say "$ROOT: no skill or snippet files to check"; else echo "warn: $ROOT: no skill or snippet files to check"; fi
fi
while IFS= read -r line; do
  if [ "$STRICT" -eq 1 ]; then say "$line"; else echo "warn: $line"; fi
done < <(for f in ${HP_FILES[@]+"${HP_FILES[@]}"}; do
  if [ ! -r "$f" ]; then echo "$f: unreadable — hostpath check could not run"; continue; fi
  awk -v file="$f" '
    {
      form = ""
      if (match($0, /~\/\.claude\/skills\/[^\/` \t]+\//)) form = substr($0, RSTART, RLENGTH)
      else if (match($0, /[Rr]ead `\.claude\/skills\//)) form = substr($0, RSTART + 6, RLENGTH - 6)
      else if (match($0, /(^|[^\/A-Za-z0-9_.-])(qa\/templates|qa\/references|review\/TODOS-format\.md)/)) {
        form = substr($0, RSTART, RLENGTH); sub(/^[^qr]/, "", form)
      }
      if (form != "")
        printf "%s:%d: hard-coded host path %s exists only where Claude Code installed the pack at that path — use ${CLAUDE_SKILL_DIR:-$HOME/.claude/skills/<name>}/... or .../../<sibling>/...\n", file, NR, form
    }' "$f" || echo "$f: awk exited $? — hostpath check could not run"
done)

# --- positionals and python isolation --------------------------------------
# The host replaces $N (digits with no word character after them) with the Nth
# invocation argument before the model sees the skill, backslash or not.
while IFS= read -r f; do
  while IFS= read -r line; do
    case "$line" in
      ERR*) say "${line#ERR }" ;;
      *) echo "$line" ;;
    esac
  done < <(awk -v file="$f" "$FENCE_AWK"'
    function positional(s,   p, n) {
      while (match(s, /[$][0-9]+/)) {
        p = substr(s, RSTART, RLENGTH); n = substr(s, RSTART + RLENGTH, 1)
        if (n !~ /[A-Za-z0-9_]/) return p
        s = substr(s, RSTART + RLENGTH)
      }
      return ""
    }
    # Echo "-c" or "-" for a python3 that runs inline code without -I.
    function unisolated(s,   rest, t, i, k, iso) {
      while (match(s, /python3[ \t]/)) {
        rest = substr(s, RSTART + RLENGTH)
        if (RSTART > 1 && substr(s, RSTART - 1, 1) ~ /[A-Za-z0-9_]/) { s = rest; continue }
        k = split(rest, t, /[ \t]+/); iso = 0
        for (i = 1; i <= k; i++) {
          if (t[i] == "") continue
          if (t[i] !~ /^-/) break
          if (t[i] == "-") { if (!iso) return "-"; break }
          if (t[i] ~ /^-[A-Za-z]*I/) iso = 1
          if (t[i] ~ /^-[A-Za-z]*c/) { if (!iso) return "-c"; break }
        }
        s = rest
      }
      return ""
    }
    {
      fenced = fence_step($0)
      p = positional($0)
      if (p != "") {
        if (fenced)
          printf "ERR %s:%d: bare %s is replaced by an invocation argument when the skill loads — use ${N} in shell, $(N) in awk, USD for money\n", file, NR, p
        else
          printf "warn: %s:%d: bare %s is replaced by an invocation argument when the skill loads — use ${N} in shell, $(N) in awk, USD for money\n", file, NR, p
      }
      if (fenced && (m = unisolated($0)) != "")
        printf "warn: %s:%d: python3 %s without -I imports from the working directory first — add -I\n", file, NR, m
    }' "$f")
done < <(ls "$ROOT"/skills/*/SKILL.md "$ROOT"/lib/snippets/*.md 2>/dev/null)

if [ "$errors" -gt 0 ]; then
  echo "vibe-lint-sources: $errors finding(s)"
  exit 1
fi
echo "vibe-lint-sources: clean"
