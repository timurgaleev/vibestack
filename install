#!/usr/bin/env bash
# vibestack install — register skills with Claude Code, Cursor, Kiro, Codex CLI
# v1.5.0: install plan UX + per-target atomic stage-and-swap

set -uo pipefail

# ───────────────────────────────────────────────────────────────────────────
# Bash 4+ guard (v1.5.0). Associative arrays are used for per-target state
# accumulation; vibestack already shipped bash-4-only patterns since v1.4.0,
# so this just makes an existing implicit requirement explicit.
# ───────────────────────────────────────────────────────────────────────────
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
  echo "ERROR: ./install requires bash 4+. Detected: ${BASH_VERSION:-unknown}" >&2
  echo "On macOS, install via Homebrew: brew install bash" >&2
  exit 4
fi

REPO_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILLS_SRC="$REPO_DIR/skills"
VIBE_HOME="${VIBESTACK_HOME:-$HOME/.vibestack}"
VIBE_BIN="$VIBE_HOME/bin"

# Renderer seam (test-only override, same spirit as VIBE_TEST_MODE). The suite
# injects a fail-on-match stub through this instead of overwriting the tracked
# bin/vibe-render-skill, which a hard-killed run used to leave replaced.
RENDERER_BIN="${VIBE_RENDER_SKILL:-$REPO_DIR/bin/vibe-render-skill}"

# ───────────────────────────────────────────────────────────────────────────
# Multi-target configuration (v1.4.0+)
#
# vibestack installs into one or more agent runtimes that adopt the Agent
# Skills open standard (agentskills.io): Claude Code, Cursor, Kiro, Codex CLI.
# Same rendered SKILL.md to each target's conventional skills path. See
# docs/agent-skills-compatibility-audit.md for runtime caveats.
# ───────────────────────────────────────────────────────────────────────────

usage() {
  cat <<'EOF'
Usage: ./install [options]

Options:
  --target=<list>   Comma-separated targets: claude, cursor, kiro, codex, or all.
                    Bypasses the interactive prompt. Default behavior asks.
                    `all` = claude, cursor, kiro, codex.
  --yes, -y         Non-interactive: install into the default set (all four).
                    Equivalent to --target=all.
  --scope=<s>       user (default) installs into ~/. project installs skills
                    into <project-root>/.claude/skills etc. — pins the pack's
                    version per repo. Runtime bin/state stay in ~/.vibestack.
  --project-root=<d>  Project root for --scope=project (default: $PWD, or
                    $VIBESTACK_PROJECT_ROOT).
  --dry-run         Preview every output, write nothing.
  -h, --help        Show this help and exit.

Default behavior:
  Interactive (TTY):     shows write plan + Enter installs detected
  Non-interactive (CI):  installs into the default set (claude, cursor, kiro,
                         codex)

  Codex reads user skills from ~/.agents/skills and repo skills from
  .agents/skills — not from ~/.codex, which holds only its config. A superseded
  copy under ~/.codex/skills is pruned (our skill names only).

Examples:
  ./install                          # Interactive: install plan + Enter
  ./install --target=all             # claude, cursor, kiro, codex (default set)
  ./install --target=cursor          # Cursor only
  ./install --target=cursor,kiro     # Cursor + Kiro
  ./install --target=codex           # Codex CLI only
  ./install --yes                    # Default set, skip prompts (CI-friendly)
  ./install --dry-run                # Interactive preview, write nothing
  ./install --scope=project --project-root=~/code/myapp --target=claude
                                     # Pin the pack into one project's tree
EOF
}

# Target registry (data-driven). Add a runtime by adding one row to each map.
#
# A target name is NOT a directory name. Codex reads user skills from
# ~/.agents/skills and repo skills from .agents/skills, while its config lives
# in ~/.codex — three different strings for one target. Hence three maps:
# where its config lives (detection), where user-scope skills go, and what the
# project-scope path is relative to a project root.
declare -A TARGET_LABEL=(
  [claude]="Claude Code"
  [cursor]="Cursor"
  [kiro]="Kiro"
  [codex]="Codex CLI"
)
# Config dir — drives detection only, never receives skills.
declare -A TARGET_CONFIG_DIR=(
  [claude]="$HOME/.claude"
  [cursor]="$HOME/.cursor"
  [kiro]="$HOME/.kiro"
  [codex]="${CODEX_HOME:-$HOME/.codex}"
)
declare -A TARGET_ROOT=(
  [claude]="$HOME/.claude/skills"
  [cursor]="$HOME/.cursor/skills"
  [kiro]="$HOME/.kiro/skills"
  # Codex's documented user-skill scope. Not under $CODEX_HOME — the docs place
  # user skills at $HOME/.agents/skills regardless of where its config lives.
  [codex]="$HOME/.agents/skills"
)
# Project scope (`--scope=project`), relative to the project root.
declare -A TARGET_PROJECT_REL=(
  [claude]=".claude/skills"
  [cursor]=".cursor/skills"
  [kiro]=".kiro/skills"
  [codex]=".agents/skills"
)

# Superseded user-scope roots. vibestack shipped codex installs into
# ~/.codex/skills before the documented path was confirmed; Codex 0.147.0 scans
# both, so leaving them there shows every skill twice. Only our own skill names
# are pruned from these — see prune_legacy_root.
declare -A TARGET_LEGACY_ROOT=(
  [codex]="${CODEX_HOME:-$HOME/.codex}/skills"
)

# Default "all"/`--yes` set — every runtime whose skill-loading path is verified.
ALL_TARGETS=("claude" "cursor" "kiro" "codex")

target_label() {
  echo "${TARGET_LABEL[$1]:-$1}"
}

target_root() {
  echo "${TARGET_ROOT[$1]:-}"
}

# Detection heuristic (tightened from the v1.4.0 proxy check).
# A target counts as present when its CLI is on PATH, or its home dir exists
# AND shows recent activity (any file modified in the last 180 days) — a stale
# `~/.cursor/` left behind by an uninstalled app no longer counts, so the
# "Enter installs detected" default stops surprising users.
#
# VIBE_TEST_MODE=1 disables the `command -v` half and the recency filter
# (test-only seam) so the integration suite can control detection precisely
# via $HOME/.<target>/ directory presence without picking up real binaries.
target_detected() {
  local t="$1"
  local cfg="${TARGET_CONFIG_DIR[$t]:-$HOME/.${t}}"
  if [ "${VIBE_TEST_MODE:-0}" = "1" ]; then
    [ -d "$cfg" ]
    return $?
  fi
  command -v "$t" >/dev/null 2>&1 && return 0
  [ -d "$cfg" ] || return 1
  # Prune the skills tree we manage — our own installs must not refresh a
  # stale runtime's activity signal indefinitely.
  [ -n "$(find "$cfg" -name skills -prune -o -type f -mtime -180 -print -quit 2>/dev/null)" ]
}

# Total skill count, computed once. Strip BSD `wc -l` whitespace.
total_skills=$(find "$SKILLS_SRC" -mindepth 1 -maxdepth 1 -type d 2>/dev/null \
  | wc -l | tr -d '[:space:]')
: "${total_skills:=0}"

# ───────────────────────────────────────────────────────────────────────────
# Argument parsing
# ───────────────────────────────────────────────────────────────────────────
TARGETS_RAW=""
DRY_RUN=0
YES_FLAG=0
SCOPE="user"
PROJECT_ROOT=""

for arg in "$@"; do
  case "$arg" in
    --target=*)
      TARGETS_RAW="${arg#*=}"
      ;;
    --scope=*)
      SCOPE="${arg#*=}"
      ;;
    --project-root=*)
      PROJECT_ROOT="${arg#*=}"
      ;;
    --yes|-y)
      YES_FLAG=1
      ;;
    --dry-run)
      DRY_RUN=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "ERROR: unknown argument: $arg" >&2
      usage >&2
      exit 2
      ;;
  esac
done

# Project scope: install skills into a project-local tree instead of $HOME, so
# a team can pin the pack's version per repo. Runtime bin/state stay global
# (~/.vibestack) — skills resolve their tools from there regardless of scope.
case "$SCOPE" in
  user) ;;
  project)
    PROJECT_ROOT="${PROJECT_ROOT:-${VIBESTACK_PROJECT_ROOT:-$PWD}}"
    # Expand a literal leading ~ (no shell tilde expansion after `--flag=`).
    case "$PROJECT_ROOT" in "~") PROJECT_ROOT="$HOME" ;; "~/"*) PROJECT_ROOT="$HOME/${PROJECT_ROOT#\~/}" ;; esac
    [ -d "$PROJECT_ROOT" ] || { echo "ERROR: project root not found: $PROJECT_ROOT" >&2; exit 2; }
    # Canonicalize (handles `.`, `..`, trailing slashes, symlinks) so hooks
    # never embed relative paths and the self-install check can't be bypassed.
    PROJECT_ROOT="$(cd "$PROJECT_ROOT" && pwd -P)" || { echo "ERROR: cannot resolve project root" >&2; exit 2; }
    _repo_real="$(cd "$REPO_DIR" && pwd -P)"
    if [ "$PROJECT_ROOT" = "$_repo_real" ]; then
      echo "ERROR: --scope=project from inside the vibestack repo needs --project-root=<your project>" >&2
      echo "       (running from the pack's own checkout would install into the pack itself)" >&2
      exit 2
    fi
    unset _repo_real
    # Read the per-target relative path from the registry rather than stripping
    # $HOME off the user-scope root: codex's repo scope is `.agents/skills`, and
    # its user root isn't under $HOME/.codex at all, so the strip would produce
    # a bogus path. Mirrors uninstall's target_root().
    for _t in "${!TARGET_ROOT[@]}"; do
      TARGET_ROOT[$_t]="$PROJECT_ROOT/${TARGET_PROJECT_REL[$_t]:-.$_t/skills}"
    done
    unset _t
    echo "Scope: project ($PROJECT_ROOT)"
    ;;
  *)
    echo "ERROR: invalid --scope '$SCOPE' (user|project)" >&2
    exit 2
    ;;
esac

# ───────────────────────────────────────────────────────────────────────────
# Signal handlers (placed AFTER arg parsing per eng-review R2).
# Per Codex outside-voice (R14): SIGINT exits 130, SIGTERM exits 143.
# ───────────────────────────────────────────────────────────────────────────
on_interrupt() {
  echo "" >&2
  echo "Installation interrupted (SIGINT); some targets may be partially updated." >&2
  echo "Re-run ./install to converge (idempotent — staging dirs are cleaned on next run)." >&2
  exit 130
}
on_terminate() {
  echo "" >&2
  echo "Installation terminated (SIGTERM); some targets may be partially updated." >&2
  echo "Re-run ./install to converge (idempotent — staging dirs are cleaned on next run)." >&2
  exit 143
}
trap on_interrupt INT
trap on_terminate TERM

# ───────────────────────────────────────────────────────────────────────────
# Install plan printer (v1.5.0)
# Prints the write plan + prompt line. Wording adapts when DRY_RUN=1
# (eng-review R4: "preview" not "install" when --dry-run is set).
# ───────────────────────────────────────────────────────────────────────────
print_install_plan() {
  local default_targets_csv="$1"  # comma-separated names, possibly empty
  local verb="install"
  local prompt_options="a=all  e=edit  d=dry-run  q=quit"
  if [ "$DRY_RUN" = "1" ]; then
    verb="preview installing"
    prompt_options="a=preview all  e=edit  q=quit"  # `d` dropped — dry-run already on
  fi

  echo "vibestack will $verb $total_skills skills into:"
  echo ""
  local t label root marker
  for t in "${ALL_TARGETS[@]}"; do
    label=$(target_label "$t")
    root=$(target_root "$t")
    if echo ",$default_targets_csv," | grep -q ",$t,"; then
      marker="✓"
    else
      marker="-"
    fi
    # Pad columns: marker(1) + label(13) + root(28) + status
    if target_detected "$t"; then
      printf "  %s %-13s %-28s detected\n" "$marker" "$label" "$root"
    else
      printf "  %s %-13s %-28s not found\n" "$marker" "$label" "$root"
    fi
  done
  echo ""
  if [ "$DRY_RUN" = "1" ]; then
    echo "Press Enter to preview.  $prompt_options"
  else
    echo "Press Enter to install.  $prompt_options"
  fi
}

# ───────────────────────────────────────────────────────────────────────────
# Resolve TARGETS
#
# Priority order (eng-review R2 ordering preserved):
#   1. --target=<list>   → use as-is (validated)
#   2. --yes / -y        → all four
#   3. TTY available     → install plan + Enter UX (NEW v1.5.0)
#   4. Non-TTY (CI)      → all four
# ───────────────────────────────────────────────────────────────────────────
declare -a TARGETS

if [ -n "$TARGETS_RAW" ]; then
  if [ "$TARGETS_RAW" = "all" ]; then
    TARGETS=("${ALL_TARGETS[@]}")
  else
    IFS=',' read -ra TARGETS <<< "$TARGETS_RAW"
  fi
  for t in "${TARGETS[@]}"; do
    # Valid = any name in the target registry (plus the literal 'all', handled
    # above). Keeps the check data-driven so a new registry row is enough.
    if [ -z "${TARGET_ROOT[$t]:-}" ]; then
      echo "ERROR: unknown target '$t'. Valid: ${!TARGET_ROOT[*]}, all." >&2
      exit 2
    fi
  done
elif [ "$YES_FLAG" = "1" ]; then
  TARGETS=("${ALL_TARGETS[@]}")
elif [ -r /dev/tty ] && [ -t 0 ]; then
  # ─── New v1.5.0 install plan + Enter UX ──────────────────────────────
  declare -a default_targets=()
  for t in "${ALL_TARGETS[@]}"; do
    if target_detected "$t"; then
      default_targets+=("$t")
    fi
  done
  default_csv=""
  if [ "${#default_targets[@]}" -gt 0 ]; then
    default_csv=$(IFS=','; echo "${default_targets[*]}")
  fi

  print_install_plan "$default_csv"

  # Two-strike unknown-input retry handler.
  attempt=0
  TARGETS=()
  while [ "$attempt" -lt 2 ]; do
    attempt=$((attempt + 1))
    reply=""
    if ! read -r reply </dev/tty; then
      reply=""  # EOF (Ctrl-D) — treat as unknown input
    fi
    case "$reply" in
      ""|y|Y)
        if [ "${#default_targets[@]}" -eq 0 ]; then
          echo ""
          echo "No targets detected. Run with \`a\` to install all four, or pass" >&2
          echo "\`--target=<list>\` explicitly." >&2
          exit 0
        fi
        TARGETS=("${default_targets[@]}")
        break
        ;;
      a|A)
        TARGETS=("${ALL_TARGETS[@]}")
        break
        ;;
      e|E)
        # Fall through to per-target loop with detection-flipped defaults.
        # Reuses v1.4.0 prompt body; defaults flip per eng-review R7
        # ([detected] annotation dropped).
        echo ""
        declare -a chosen=()
        for t in "${ALL_TARGETS[@]}"; do
          label=$(target_label "$t")
          root=$(target_root "$t")
          if target_detected "$t"; then
            printf "  Install into %s (%s)? [Y/n] " "$label" "$root"
            default_yes=1
          else
            printf "  Install into %s (%s)? [y/N] " "$label" "$root"
            default_yes=0
          fi
          edit_reply=""
          if ! read -r edit_reply </dev/tty; then
            edit_reply=""
          fi
          case "$edit_reply" in
            y|Y|yes|YES) chosen+=("$t") ;;
            n|N|no|NO)   ;;
            "")          [ "$default_yes" = "1" ] && chosen+=("$t") ;;
            *)           [ "$default_yes" = "1" ] && chosen+=("$t") ;;
          esac
        done
        echo ""
        if [ "${#chosen[@]}" -eq 0 ]; then
          echo "No targets selected. Nothing to install."
          exit 0
        fi
        TARGETS=("${chosen[@]}")
        break
        ;;
      d|D)
        # Dry-run from prompt (eng-review R3: empty defaults → exit with hint).
        if [ "${#default_targets[@]}" -eq 0 ]; then
          echo ""
          echo "Nothing to dry-run — no targets detected. Use \`a\` to preview all 3," >&2
          echo "or pass \`--target=<list>\` explicitly." >&2
          exit 0
        fi
        DRY_RUN=1
        TARGETS=("${default_targets[@]}")
        break
        ;;
      n|N|q|Q)
        echo ""
        echo "Nothing to install."
        exit 0
        ;;
      *)
        if [ "$attempt" -ge 2 ]; then
          echo "" >&2
          echo "Two unknown inputs in a row. Aborting." >&2
          echo "Valid: Enter / a / e / d / q (or n)." >&2
          exit 1
        fi
        echo "  (unknown input — try a/e/d/q or Enter)" >&2
        ;;
    esac
  done
else
  # Non-TTY (CI, piped) → install the full default set.
  TARGETS=("${ALL_TARGETS[@]}")
fi

# Empty TARGETS guard (defensive — shouldn't reach here but just in case).
if [ "${#TARGETS[@]}" -eq 0 ]; then
  echo "ERROR: no targets resolved. Re-run with --target=<list> or --yes." >&2
  exit 2
fi

# If this repo checkout lives inside a target's skills root — the documented
# `git clone … ~/.claude/skills/vibestack` puts it inside the Claude target —
# install that target LAST. Its atomic swap renames the root aside (this repo,
# with its skills/ source and bin/ renderer, included), which would leave any
# target processed afterward with no source to render from (0/N installed).
# The containing target's own render completes before its swap, so moving it to
# the end is safe and makes multi-target install order-independent.
_ordered=(); _deferred=()
for _t in "${TARGETS[@]}"; do
  _r=$(target_root "$_t")
  if [ -n "$_r" ]; then
    case "$REPO_DIR/" in
      "$_r"/*) _deferred+=("$_t"); continue ;;
    esac
  fi
  _ordered+=("$_t")
done
TARGETS=("${_ordered[@]}" "${_deferred[@]}")
unset _ordered _deferred _t _r

# Static source lint — fail fast before rendering anything. An unbalanced
# fence or a broken snippet would otherwise render silently-wrong skills.
if ! bash "$REPO_DIR/bin/vibe-lint-sources" "$REPO_DIR"; then
  echo "ERROR: source lint failed — fix the findings above, then re-run ./install" >&2
  exit 1
fi

# ───────────────────────────────────────────────────────────────────────────
# Per-skill install — renders SKILL.md to a target dir + symlinks bin/ and
# sub-docs. Body unchanged from v1.4.0; v1.5.0 just calls it with a staging
# dir as the second arg instead of the production target_root.
# ───────────────────────────────────────────────────────────────────────────
install_skill_to_target() {
  local skill_dir="$1"
  local target_root="$2"
  # Production root the files will finally live under (differs from
  # target_root during staged installs). Drives ${CLAUDE_SKILL_DIR}
  # substitution so hook/body paths are correct per target runtime.
  local final_root="${3:-$2}"
  local skill_name target

  skill_name=$(grep -m1 '^name:' "$skill_dir/SKILL.md" 2>/dev/null \
    | sed 's/^name:[[:space:]]*//' | tr -d '[:space:]')
  [ -z "$skill_name" ] && skill_name="$(basename "$skill_dir")"

  target="$target_root/$skill_name"

  if [ "$DRY_RUN" = "1" ]; then
    echo "  would render: $skill_dir → $target/SKILL.md"
    return 0
  fi

  if ! mkdir -p "$target"; then
    echo "ERROR: cannot create $target" >&2
    return 3
  fi

  [ -L "$target/SKILL.md" ] && rm -f "$target/SKILL.md"

  if ! "$RENDERER_BIN" --skill-dir "$final_root/$skill_name" \
      "${skill_dir%/}/SKILL.md" "$target/SKILL.md"; then
    echo "ERROR: render failed for $skill_name → $target" >&2
    return 2
  fi

  if [ -d "${skill_dir%/}/bin" ]; then
    ln -sfn "${skill_dir%/}/bin" "$target/bin"
    chmod +x "${skill_dir%/}"/bin/*.sh 2>/dev/null || true
  fi

  for item in "${skill_dir%/}"/*; do
    [ -e "$item" ] || continue
    item_name=$(basename "$item")
    [ "$item_name" = "SKILL.md" ] && continue
    [ "$item_name" = "bin" ] && continue
    ln -sfn "$item" "$target/$item_name"
  done

  return 0
}

# ───────────────────────────────────────────────────────────────────────────
# Ownership boundary.
#
# The atomic swap replaces a target's whole skills/ root, so anything in there
# that vibestack did not write — a hand-authored skill, another installer's
# skill, a runtime's own bundled set (Codex keeps its system skills in
# `.system/`) — would be carried off to .old and deleted by a later recovery
# pass. We own our own skill names and nothing else: every other entry is
# adopted back into the live root.
#
# `vibestack_owned_names` derives names exactly as install_skill_to_target
# does (frontmatter `name:`, falling back to the directory basename) so the two
# can never disagree about what belongs to us.
# ───────────────────────────────────────────────────────────────────────────
vibestack_owned_names() {
  local skill_dir name
  for skill_dir in "$SKILLS_SRC"/*/; do
    [ -f "$skill_dir/SKILL.md" ] || continue
    name=$(grep -m1 '^name:' "$skill_dir/SKILL.md" 2>/dev/null \
      | sed 's/^name:[[:space:]]*//' | tr -d '[:space:]')
    [ -z "$name" ] && name="$(basename "$skill_dir")"
    echo "$name"
  done
}

# Move every entry in $1 that is not a vibestack skill into $2. Dotfiles
# included — `.system/` is exactly the case that matters. An entry whose name
# already exists in the destination is left behind rather than overwritten:
# the live root wins, and the leftover stays in .old for inspection.
adopt_foreign_entries() {
  local from="$1" to="$2"
  [ -d "$from" ] && [ -d "$to" ] || return 0

  local owned entry base
  owned=$'\n'"$(vibestack_owned_names)"$'\n'

  for entry in "$from"/* "$from"/.[!.]* "$from"/..?*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    base="$(basename "$entry")"
    case "$owned" in *$'\n'"$base"$'\n'*) continue ;; esac
    if [ -e "$to/$base" ] || [ -L "$to/$base" ]; then
      continue
    fi
    mv "$entry" "$to/$base" 2>/dev/null || true
  done
}

# Remove our own skills from a target's superseded user-scope root. Codex scans
# both ~/.agents/skills and the ~/.codex/skills we used to install into, so a
# leftover copy shows every skill twice — and the stale copy never updates.
#
# Only our own names are removed, one directory at a time, and only from the
# legacy root. Never the root itself: a runtime's bundled skills live there
# (Codex's `.system/`) and so may skills another tool installed.
prune_legacy_root() {
  local t="$1"
  local legacy="${TARGET_LEGACY_ROOT[$t]:-}"
  local current="${TARGET_ROOT[$t]:-}"
  [ -n "$legacy" ] || return 0
  [ -d "$legacy" ] || return 0
  # Only prune when we are installing somewhere else — never delete the copy we
  # just wrote (a user with $CODEX_HOME pointing at the new root, say).
  [ "$legacy" = "$current" ] && return 0

  local name pruned=0
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    # Ours only if it carries the marks of a vibestack render.
    if [ -f "$legacy/$name/SKILL.md" ] || [ -f "$legacy/$name/.vibe-render.json" ]; then
      if [ "$DRY_RUN" = "1" ]; then
        echo "  would prune superseded: $legacy/$name"
      else
        rm -rf "$legacy/$name" 2>/dev/null && pruned=$((pruned + 1))
      fi
    fi
  done <<< "$(vibestack_owned_names)"

  if [ "$pruned" -gt 0 ]; then
    echo "  pruned $pruned superseded skill(s) from $legacy"
    rmdir "$legacy" 2>/dev/null || true
  fi
}

# Remove skills this install used to write and no longer ships.
#
# adopt_foreign_entries cannot do this: a skill dropped from the pack is not in
# vibestack_owned_names any more, so it looks exactly like a skill some other
# tool installed and gets carried back into the live root. Without a record of
# what we wrote last time, a removed skill lives on in every target — still
# listed, still routable, never updated again.
#
# The manifest is that record. It sits inside the target root, so it survives
# the swap through adopt_foreign_entries and works the same in project scope.
# Only a name the manifest claims is ever removed, and only when the directory
# still looks like a skill: a foreign directory that happens to share a name
# with a skill we once shipped keeps its contents.
SKILL_MANIFEST_NAME=".vibestack-manifest"

prune_removed_skills() {
  local root="$1"
  local manifest="$root/$SKILL_MANIFEST_NAME"
  local owned name pruned=0

  owned=$'\n'"$(vibestack_owned_names)"$'\n'

  if [ -f "$manifest" ]; then
    while IFS= read -r name; do
      [ -n "$name" ] || continue
      case "$owned" in *$'\n'"$name"$'\n'*) continue ;; esac
      [ -f "$root/$name/SKILL.md" ] || continue
      if [ "$DRY_RUN" = "1" ]; then
        echo "  would remove withdrawn skill: $root/$name"
      else
        rm -rf "$root/$name" 2>/dev/null && pruned=$((pruned + 1))
      fi
    done < "$manifest"
  fi

  [ "$pruned" -gt 0 ] && echo "  removed $pruned withdrawn skill(s) from $root"

  if [ "$DRY_RUN" != "1" ]; then
    vibestack_owned_names > "$manifest" 2>/dev/null || true
  fi
}

# ───────────────────────────────────────────────────────────────────────────
# Recovery pass for a target (v1.5.0).
#
# Cleans orphaned staging/.old directories from prior failed/interrupted runs.
# Power-failure recovery: if production skills/ is missing AND .old exists,
# restore .old → skills (rollback the partial mv chain).
# ───────────────────────────────────────────────────────────────────────────
recover_target_state() {
  local root="$1"
  local parent staging_glob old_dir
  parent="$(dirname "$root")"
  [ -d "$parent" ] || return 0

  old_dir="${root}.old"

  # Power-failure recovery: skills/ missing but .old present → restore.
  if [ ! -d "$root" ] && [ -d "$old_dir" ]; then
    if mv "$old_dir" "$root" 2>/dev/null; then
      echo "  (recovered from prior interrupted install: restored $root)" >&2
    fi
  fi

  # Clean stale .old directories older than 1 hour (3600s). Rescue any
  # foreign entry still parked there first — a run interrupted between the swap
  # and its adopt step leaves other installers' skills in .old, and deleting
  # them here would make that interruption permanent.
  if [ -d "$old_dir" ]; then
    if [ -n "$(find "$old_dir" -maxdepth 0 -mmin +60 2>/dev/null)" ]; then
      adopt_foreign_entries "$old_dir" "$root"
      rm -rf "$old_dir"
    fi
  fi

  # Clean ALL orphaned staging dirs (any age — they're transient).
  for staging_glob in "${root}.staging."*; do
    [ -d "$staging_glob" ] || continue
    # Keep .staging.failed.* under 24h for debugging; remove older than that.
    case "$staging_glob" in
      *.staging.failed.*)
        if [ -n "$(find "$staging_glob" -maxdepth 0 -mmin +1440 2>/dev/null)" ]; then
          rm -rf "$staging_glob"
        fi
        ;;
      *)
        rm -rf "$staging_glob"
        ;;
    esac
  done
}

# ───────────────────────────────────────────────────────────────────────────
# Main install flow
# ───────────────────────────────────────────────────────────────────────────

if [ "$DRY_RUN" = "1" ]; then
  echo "Installing vibestack (DRY RUN — no files will be written)..."
else
  echo "Installing vibestack..."
fi

# Create vibestack state and bin directories (skip in dry-run).
if [ "$DRY_RUN" != "1" ]; then
  mkdir -p "$VIBE_BIN"
  mkdir -p "$VIBE_HOME/projects"
  mkdir -p "$VIBE_HOME/analytics"

  if [ -d "$REPO_DIR/bin" ]; then
    for script in "$REPO_DIR/bin"/vibe-*; do
      [ -f "$script" ] || continue
      name=$(basename "$script")
      cp "$script" "$VIBE_BIN/$name"
      chmod +x "$VIBE_BIN/$name"
    done
    # Umbrella CLI + version stamp so `vibestack` works anywhere once
    # $VIBE_BIN is on PATH (like a server-side CLI).
    if [ -f "$REPO_DIR/bin/vibestack" ]; then
      cp "$REPO_DIR/bin/vibestack" "$VIBE_BIN/vibestack"
      chmod +x "$VIBE_BIN/vibestack"
    fi
    echo "  + vibestack tools → $VIBE_BIN"
    case ":$PATH:" in
      *":$VIBE_BIN:"*) : ;;
      *) echo "  note: add to PATH for the CLI:  export PATH=\"\$PATH:$VIBE_BIN\"" ;;
    esac
  fi

  # Full browse daemon (optional). When bun is available, install the daemon's
  # deps so /browse + /open-browser get the rich TypeScript daemon (CDP inspector,
  # PTY, sidebar extension, content-security). Idempotent; non-fatal — /browse
  # falls back to the bundled stateless Playwright shim when this is absent.
  if [ -f "$REPO_DIR/package.json" ] && command -v bun >/dev/null 2>&1; then
    # Re-run bun install when ANY runtime dep is missing — checking only
    # playwright left upgrades without newer deps (e.g. make-pdf's html-to-docx).
    if [ ! -d "$REPO_DIR/node_modules/playwright" ] || [ ! -d "$REPO_DIR/node_modules/html-to-docx" ]; then
      echo "  + browse daemon: installing deps (bun)…"
      if ( cd "$REPO_DIR" && bun install >/dev/null 2>&1 ); then
        ( cd "$REPO_DIR" && bun run vendor:xterm >/dev/null 2>&1 ) || true
        echo "    browse daemon ready"
      else
        echo "    browse deps failed — /browse uses the stateless shim"
      fi
    else
      echo "  + browse daemon deps present"
    fi
  fi

  if ! echo "$PATH" | tr ':' '\n' | grep -qF "$VIBE_BIN"; then
    echo ""
    echo "  NOTE: Add $VIBE_BIN to your PATH:"
    echo "    echo 'export PATH=\"$VIBE_BIN:\$PATH\"' >> ~/.zshrc"
  fi
fi

# Per-target staging + atomic swap.
# Single source of truth: target_status, target_count, target_failed_at,
# hook_count maps (eng-review R1).
declare -A target_status      # target → ok|failed
declare -A target_count       # target → "N/M"
declare -A target_failed_at   # target → skill name (only on failure)
declare -A hook_count         # target → number of hook-bearing skills installed
hook_skills_installed_non_claude=0

for target in "${TARGETS[@]}"; do
  root=$(target_root "$target")
  label=$(target_label "$target")
  if [ -z "$root" ]; then
    echo "ERROR: could not resolve root for target '$target'" >&2
    target_status["$target"]="failed"
    target_failed_at["$target"]="(invalid target name)"
    target_count["$target"]="0/$total_skills"
    continue
  fi

  echo ""
  if [ "$DRY_RUN" = "1" ]; then
    echo "── $label ($root) [DRY RUN]"
  else
    echo "── $label ($root)"
  fi

  # Recovery pass before this target's install.
  if [ "$DRY_RUN" != "1" ]; then
    recover_target_state "$root"
  fi

  # Determine where renders go: staging dir for atomic swap, or directly to
  # root for dry-run (which doesn't write anyway).
  if [ "$DRY_RUN" = "1" ]; then
    staging_dir="$root"
  else
    staging_dir="${root}.staging.$$"
    if ! mkdir -p "$staging_dir"; then
      echo "ERROR: cannot create staging dir $staging_dir" >&2
      target_status["$target"]="failed"
      target_failed_at["$target"]="(staging mkdir)"
      target_count["$target"]="0/$total_skills"
      hook_count["$target"]=0
      continue
    fi
  fi

  installed=0
  failed_skill=""
  this_target_hooks=0

  for skill_dir in "$SKILLS_SRC"/*/; do
    [ -f "$skill_dir/SKILL.md" ] || continue

    if ! install_skill_to_target "$skill_dir" "$staging_dir" "$root"; then
      failed_skill=$(basename "$skill_dir")
      break  # Per-target fail-fast; cross-target continue.
    fi

    installed=$((installed + 1))

    if [ "$target" != "claude" ] && grep -q "^hooks:" "$skill_dir/SKILL.md" 2>/dev/null; then
      this_target_hooks=$((this_target_hooks + 1))
    fi
  done

  target_count["$target"]="$installed/$total_skills"
  hook_count["$target"]=$this_target_hooks

  # Resolve outcome for this target.
  if [ -n "$failed_skill" ]; then
    target_status["$target"]="failed"
    target_failed_at["$target"]="$failed_skill"
    # Park staging dir as .staging.failed.<ts> for debugging — don't touch prod.
    if [ "$DRY_RUN" != "1" ] && [ -d "$staging_dir" ]; then
      mv "$staging_dir" "${root}.staging.failed.$(date +%s)" 2>/dev/null || rm -rf "$staging_dir"
    fi
    echo "  installing $total_skills skills... failed at /${failed_skill}"
  else
    target_status["$target"]="ok"
    if [ "$DRY_RUN" != "1" ]; then
      # Hook count attaches to the global counter ONLY on successful targets
      # (R15: warn about hooks that actually landed, even on partial success).
      hook_skills_installed_non_claude=$((hook_skills_installed_non_claude + this_target_hooks))
      # Atomic swap: rename current root aside, swap staging in.
      if [ -d "$root" ]; then
        # Remove any prior .old first — recovery only cleans .old >1h old, so
        # rapid reruns can leave a recent .old in place. Without this, `mv root
        # .old` would move root INSIDE the existing .old dir (POSIX mv behavior
        # when target is a non-empty dir), corrupting the rollback layout and
        # accumulating nested backups across reruns.
        adopt_foreign_entries "${root}.old" "$root"
        rm -rf "${root}.old" 2>/dev/null
        if ! mv "$root" "${root}.old" 2>/dev/null; then
          echo "ERROR: cannot move $root aside for atomic swap" >&2
          target_status["$target"]="failed"
          target_failed_at["$target"]="(swap-aside)"
          rm -rf "$staging_dir"
          echo "  installing $total_skills skills... failed at swap"
          continue
        fi
      fi
      if ! mv "$staging_dir" "$root" 2>/dev/null; then
        echo "ERROR: cannot swap staging $staging_dir → $root" >&2
        # Try to roll back .old → root.
        [ -d "${root}.old" ] && mv "${root}.old" "$root" 2>/dev/null
        target_status["$target"]="failed"
        target_failed_at["$target"]="(swap-in)"
        echo "  installing $total_skills skills... failed at swap"
        continue
      fi
      # The staged tree holds only vibestack skills, so the swap just carried
      # every foreign entry off to .old. Put them back into the live root —
      # without this, an unrelated skill (or Codex's bundled `.system/`) is
      # silently removed here and deleted for good by a later recovery pass.
      adopt_foreign_entries "${root}.old" "$root"
      # Old install lingers as .old until next run's recovery pass cleans it.
      # Our skills landed in the current root — drop any copy still sitting in a
      # superseded one (user scope only; project scope has no legacy path).
      [ "$SCOPE" = "user" ] && prune_legacy_root "$target"
      # A skill we shipped last time and dropped since is still sitting here —
      # adopt_foreign_entries just carried it back in. Remove it by name.
      prune_removed_skills "$root"
    fi
    echo "  installing $total_skills skills... done ($installed/$total_skills)"
  fi
done

# ───────────────────────────────────────────────────────────────────────────
# Outcome summary (v1.5.0)
#
# Compute any_failed. Output strings preserve v1.4.x form on the all-success
# path ("Installation complete:" colon-form). Failure path uses
# "Installation incomplete:" header. Hook warning fires when ANY successful
# non-claude target landed hook-bearing skills (R15 — surfaces safety info
# even on partial success). Happy-path CTA suppressed on any failure.
# ───────────────────────────────────────────────────────────────────────────
any_failed=0
for t in "${TARGETS[@]}"; do
  [ "${target_status[$t]:-}" = "failed" ] && any_failed=1
done

echo ""
if [ "$any_failed" = "1" ]; then
  echo "Installation incomplete:"
  # Successes first.
  for t in "${TARGETS[@]}"; do
    if [ "${target_status[$t]:-}" = "ok" ]; then
      label=$(target_label "$t")
      root=$(target_root "$t")
      if [ "$DRY_RUN" = "1" ]; then
        echo "  ✓ $label: ${target_count[$t]} skills (would write)"
      else
        echo "  ✓ $label: ${target_count[$t]} skills → $root"
      fi
    fi
  done
  # Failures last (eye-anchored at bottom).
  for t in "${TARGETS[@]}"; do
    if [ "${target_status[$t]:-}" = "failed" ]; then
      label=$(target_label "$t")
      root=$(target_root "$t")
      failed_at="${target_failed_at[$t]:-?}"
      echo "  ✗ $label: failed at /${failed_at} ($root/${failed_at}/SKILL.md)"
    fi
  done
  echo ""
  echo "Re-run ./install after fixing the underlying error (idempotent)."
  # Hook warning STILL fires if hooks landed in successful targets (R15).
  if [ "$DRY_RUN" != "1" ] && [ "$hook_skills_installed_non_claude" -gt 0 ]; then
    echo ""
    echo "  ⚠ Hook-bearing skills (careful, freeze, guard, investigate) were"
    echo "    installed into non-Claude targets that completed. Their PreToolUse"
    echo "    hooks may not fire identically across Cursor/Kiro/Codex."
    echo "    Verify per: docs/hook-verification.md"
  fi
  # Happy-path CTA suppressed on partial failure.
  exit 1
fi

# All targets succeeded — preserve v1.4.x output form exactly.
if [ "$DRY_RUN" = "1" ]; then
  echo "Dry run complete. Would install:"
else
  echo "Installation complete:"
fi
for t in "${TARGETS[@]}"; do
  label=$(target_label "$t")
  root=$(target_root "$t")
  if [ "$DRY_RUN" = "1" ]; then
    echo "  $label: ${target_count[$t]} skills (would write)"
  else
    echo "  $label: ${target_count[$t]} skills → $root"
  fi
done

# Hook warning preserved on success path.
if [ "$DRY_RUN" != "1" ] && [ "$hook_skills_installed_non_claude" -gt 0 ]; then
  echo ""
  echo "  ⚠ Hook-bearing skills (careful, freeze, guard, investigate) were"
  echo "    installed into non-Claude targets. Their PreToolUse hooks may"
  echo "    not fire identically across Cursor/Kiro/Codex."
  echo "    Verify per: docs/hook-verification.md"
fi

# Version stamp — written only after every target installed successfully, so
# `vibestack version` never claims a release that failed to land.
if [ "$DRY_RUN" != "1" ] && [ -f "$REPO_DIR/VERSION" ]; then
  cp "$REPO_DIR/VERSION" "$VIBE_HOME/version"
fi

# Happy-path CTA — intent-routed first move.
if [ "$DRY_RUN" != "1" ]; then
  echo ""
  echo "First move (in a new session of your chosen agent):"
  echo "  • Starting from an idea → /office-hours  (or /spec to pin down a spec)"
  echo "  • Existing code to work on → /qa  (or /investigate for a bug)"
  echo "Full skill list: docs/skills.md"
  echo "Compatibility matrix: docs/agent-skills-compatibility-audit.md"
  echo "Uninstall: $REPO_DIR/uninstall"
fi

exit 0
